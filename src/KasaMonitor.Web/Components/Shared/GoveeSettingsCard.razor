@using KasaMonitor.Workers
@using KasaMonitor.Core.Climate
@inject IClimateSettingsService ClimateSettings
@inject ClimateState Climate
@inject ClimateWorker Worker
@implements IDisposable

@* /settings „Govee”: the key's state (never its value), the account's thermometers with the „acasă” tick. Only the
   ticked ones are read and stored; the others (e.g. the clients' thermometers, read by the sff stack) are left alone. *@
<div class="card h-100">
    <div class="card-header fw-semibold"><i class="bi bi-thermometer-half me-2"></i>Govee (termometre Wi-Fi)</div>
    <div class="card-body">
        @if (_s is null)
        {
            <span class="text-secondary small">Se încarcă…</span>
        }
        else
        {
            <div class="mb-2 small">
                <span class="me-1">Cheia API:</span>
                @if (_s.HasGoveeKey)
                {
                    <span class="badge text-bg-success">încărcată</span>
                    <span class="ms-1 text-secondary">•••••••• din @_s.GoveeKeySource</span>
                }
                else
                {
                    <span class="badge text-bg-warning">lipsă</span>
                    <span class="ms-1 text-secondary">@_s.GoveeKeyProblem</span>
                }
            </div>
            @if (_s.HasGoveeKey)
            {
                var devices = Climate.GoveeDevices;
                <div class="d-flex align-items-center gap-2 small mb-1">
                    <span class="fw-semibold">Dispozitivele din cont</span>
                    @if (Climate.GoveeDevicesUtc is { } at) { <span class="text-secondary">(listă citită @at.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span> }
                    <button class="btn btn-outline-secondary btn-sm ms-auto py-0" @onclick="Refresh" title="Citește din nou lista dispozitivelor din contul Govee"><i class="bi bi-arrow-clockwise me-1"></i>Reîncarcă</button>
                </div>
                @if (devices is null)
                {
                    <div class="small text-secondary">Lista nu a fost citită încă.</div>
                }
                else if (devices.Count == 0)
                {
                    <div class="small text-secondary">Contul nu are dispozitive.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-1 small">
                        <thead><tr><th>Acasă</th><th>Nume</th><th>Model</th></tr></thead>
                        <tbody>
                            @foreach (var d in devices)
                            {
                                var home = _s.GoveeHomeDevices.Contains(d.Device);
                                <tr>
                                    <td>
                                        <input class="form-check-input" type="checkbox" checked="@home" disabled="@(!d.IsThermometer)"
                                               @onchange="e => ToggleAsync(d, e.Value is true)" aria-label="@("Acasă: " + d.Name)" />
                                    </td>
                                    <td>@d.Name</td>
                                    <td>@d.Sku@(d.IsThermometer ? "" : " (fără temperatură)")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (Climate.SourceStatus(ClimateSources.Govee) is { } st) { <div class="small text-danger">@st</div> }
                <div class="small text-secondary">
                    Cereri azi: <b>@Climate.GoveeCalls.Today.ToString("N0")</b> / @GoveeApi.DailyRequestLimit.ToString("N0") ·
                    la @_s.GoveeHomeDevices.Count bifat(e) ≈ @GoveeApi.RequestsPerDay(_s.GoveeHomeDevices.Count).ToString("N0")/zi
                </div>
            }
            <div class="form-text">
                Doar dispozitivele bifate „acasă” sunt citite (la 10 min) și salvate; restul nu sunt atinse. Debifarea ascunde senzorul în
                <a href="/clima">Climă</a> (istoricul rămâne). Cheia nu se scrie în bază și nu se afișează: vine din fișierul montat în container
                (<code>GOVEE_API_KEY_FILE</code> / <code>KasaMonitor__GoveeApiKeyFile</code>, implicit <code>@GoveeApi.DefaultKeyFile</code>)
                sau din <code>KasaMonitor__GoveeApiKey</code>, citită la pornire.
            </div>
            @if (_error is not null) { <div class="text-danger small mt-1">@_error</div> }
        }
    </div>
</div>

@code {
    private ClimateRuntimeSettings? _s;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Climate.Changed += OnChanged;
        await LoadAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync() => _s = await ClimateSettings.GetAsync(CancellationToken.None);

    private async Task ToggleAsync(GoveeDevice d, bool home)
    {
        _error = null;
        try
        {
            await ClimateSettings.SetGoveeHomeAsync(d.Device, home, CancellationToken.None);
            await LoadAsync();
            Worker.Wake();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Refresh() => Worker.Wake(refreshGoveeList: true);

    public void Dispose() => Climate.Changed -= OnChanged;
}
