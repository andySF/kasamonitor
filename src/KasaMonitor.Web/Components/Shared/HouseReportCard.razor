@using KasaMonitor.Core.Metering
@using KasaMonitor.Core.Reports
@using KasaMonitor.Web.Ui
@using KasaMonitor.Workers
@inject EnergyReportService Reports
@inject IKasaSettingsService KasaSettings

@* /history "Casă": the main meter split into the measured plugs and the rest of the house, ViCare-style periods. *@
@if (_noMain)
{
    <p class="small text-secondary mb-3"><i class="bi bi-house-door me-1"></i>Secțiunea „Casă” apare după ce un canal are rolul „contor general” (pagina <a href="/plugs">Dispozitive</a>).</p>
}
else
{
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <span class="fw-semibold"><i class="bi bi-house-door me-2"></i>Casă@(_report is { } hr ? " — " + hr.MainAlias : "")</span>
            <span class="text-secondary" style="cursor: help" title="@SourcesNote">ⓘ</span>
        </div>
        <div class="card-body">
            <ReportPeriodPicker Period="_period" PeriodChanged="OnPeriodChanged" Today="_today" />

            @if (_error is { } err)
            {
                <div class="alert alert-warning mt-2 mb-0">Raportul nu a putut fi încărcat: @err</div>
            }
            else if (_report is null)
            {
                <p class="text-secondary mt-2 mb-0"><span class="spinner-border spinner-border-sm me-2"></span>Se încarcă…</p>
            }
            else
            {
                var r = _report;
                <div class="d-flex flex-wrap gap-4 mt-3">
                    <div>
                        <div class="small text-secondary">Casă (contor general)</div>
                        <div class="fs-4 fw-semibold">@(r.HouseTotalKwh is { } h ? ReportFormat.Kwh(h) + " kWh" : "fără date")</div>
                        @if (r.HouseTotalKwh is { } hc) { <div class="small text-secondary">@EnergyFormat.Lei(Cost(hc))</div> }
                    </div>
                    <div>
                        <div class="small text-secondary">Prize măsurate</div>
                        <div class="fs-5 fw-semibold">@(ReportFormat.Kwh(r.PlugsTotalKwh)) kWh</div>
                    </div>
                    <div title="@ReportFormat.RestKwhTitle(r.RestTotalKind)">
                        <div class="small text-secondary">Restul casei</div>
                        <div class="fs-5 fw-semibold">@ReportFormat.RestKwh(r.RestTotalKwh, r.RestTotalKind) kWh</div>
                    </div>
                    <div title="@($"Perioada precedentă: {ReportFormat.Title(r.Period.Previous())}")">
                        <div class="small text-secondary">@ReportFormat.VersusPrevious(r.Period.Kind)@(r.IsCurrent ? " (perioadă în curs)" : "")</div>
                        @if (ReportFormat.Delta(r.DeltaPct) is { } d)
                        {
                            <div class="fs-5 fw-semibold @ReportFormat.DeltaClass(r.DeltaPct)" title="@(r.IsCurrent ? "Perioada curentă e încă în curs: se compară cu perioada precedentă întreagă" : "")">@d</div>
                            <div class="small text-secondary">înainte: @ReportFormat.Kwh(r.PreviousHouseTotalKwh) kWh</div>
                        }
                        else
                        {
                            <div class="small text-secondary">@ReportFormat.NoDelta(r.PreviousHouseTotalKwh)</div>
                        }
                    </div>
                </div>

                @if (r.DayWithoutHours)
                {
                    <div class="alert alert-secondary mt-3 mb-0">Fără defalcare pe ore (fluxul live nu a rulat în această zi); totalul zilei vine din memoria contorului.</div>
                }
                else if (r.HouseKwh.All(v => v is null))
                {
                    <div class="alert alert-secondary mt-3 mb-0">Fără date pentru această perioadă@(NoDataHint(r)).</div>
                }
                else
                {
                    <ApexChart @key="_chartKey" TItem="Bar" Options="_options" Height="280">
                        <ApexPointSeries TItem="Bar" Items="_plugBars" Name="Prize măsurate" Color="#0072B2" SeriesType="SeriesType.Bar" XValue="@(b => b.Label)" YValue="@(b => b.Kwh)" />
                        <ApexPointSeries TItem="Bar" Items="_restBars" Name="Restul casei" Color="@KasaMonitor.Core.History.AllPlugsDailyEnergy.HouseColor" SeriesType="SeriesType.Bar" XValue="@(b => b.Label)" YValue="@(b => b.Kwh)" />
                    </ApexChart>
                    @if (r.Period.Start < (r.FirstHouseDay ?? DateOnly.MaxValue))
                    {
                        <div class="small text-secondary">Fără date înainte de @(r.FirstHouseDay is { } f ? ReportFormat.Date(f) : "prima zi salvată") (istoricul vine din memoria contorului și din fluxul live).</div>
                    }
                    @if (r.RestClamped)
                    {
                        <div class="small text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>În unele intervale @ReportFormat.NegativeText (restul e afișat 0).</div>
                    }
                    @if (r.RestPartial)
                    {
                        <div class="small text-secondary"><i class="bi bi-hourglass-split me-1"></i>„date parțiale”: prizele depășesc contorul într-un interval în care fluxul live al contorului acoperă sub 90 % din minute (nu e o problemă de clemă).</div>
                    }
                    @if (r.RestWithinMargin)
                    {
                        <div class="small text-secondary">„≈” = diferența contor − prize e @ReportFormat.WithinMarginText (max(15 W × ore, 3 % din casă)).</div>
                    }

                    <div class="table-responsive mt-2" style="max-height: 24rem;">
                        <table class="table table-sm align-middle mb-0 report-table">
                            <thead class="table-light sticky-top"><tr><th>@(r.Period.Kind == ReportGranularity.Day ? "Ora" : r.Period.Kind == ReportGranularity.Year ? "Luna" : "Ziua")</th><th>Casă kWh</th><th>Prize kWh</th><th>Rest kWh</th><th>Lei casă</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < r.Buckets.Count; i++)
                                {
                                    var b = r.Buckets[i];
                                    <tr class="@(r.HouseKwh[i] is null ? "text-secondary" : "")">
                                        <td>@ReportFormat.BucketRow(b, r.Period.Kind)</td>
                                        <td>@ReportFormat.Kwh(r.HouseKwh[i])</td>
                                        <td>@(r.HouseKwh[i] is null ? "—" : ReportFormat.Kwh(r.PlugsKwh[i]))</td>
                                        <td title="@ReportFormat.RestKwhTitle(r.RestKinds[i])">@(r.HouseKwh[i] is null ? "—" : ReportFormat.RestKwh(r.RestKwh[i], r.RestKinds[i]))</td>
                                        <td>@(r.HouseKwh[i] is { } hk ? HeatingFormat.Number((double)Cost(hk), 2) : "—")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-semibold">
                                    <td>Total@(r.Period.Kind == ReportGranularity.Day ? " zi" : "")</td>
                                    <td>@ReportFormat.Kwh(r.HouseTotalKwh)</td>
                                    <td>@ReportFormat.Kwh(r.PlugsTotalKwh)</td>
                                    <td title="@ReportFormat.RestKwhTitle(r.RestTotalKind)">@ReportFormat.RestKwh(r.RestTotalKwh, r.RestTotalKind)</td>
                                    <td>@(r.HouseTotalKwh is { } ht ? HeatingFormat.Number((double)Cost(ht), 2) : "—")</td>
                                </tr>
                                @foreach (var s in r.SubMeters)
                                {
                                    <tr class="text-secondary" title="Sub-contor: nu se adună la casă (e deja inclus în contorul general sau e alt circuit)">
                                        <td><i class="bi bi-speedometer me-1"></i>@s.Alias (sub-contor)</td>
                                        <td colspan="4">@ReportFormat.Kwh(s.Kwh) kWh</td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                    </div>
                    <div class="form-text">Tarif @_tariff.ToString("0.00") RON/kWh (Setări).@(r.Period.Kind == ReportGranularity.Day ? " Totalul zilei = ziua salvată din contor (sau suma fluxului live, dacă e mai mare); orele vin doar din fluxul live." : "")</div>
                }
            }
        </div>
    </div>
}

<style>
    .report-table td:nth-child(n+2), .report-table th:nth-child(n+2) { text-align: right; }
</style>

@code {
    public record Bar(string Label, decimal? Kwh);

    private const string SourcesNote =
        "Zile: istoricul zilnic al canalelor (memoria contorului Shelly citită la 6 h, prizele Kasa/Tapo din memoria lor). " +
        "Azi: valoarea salvată sau suma fluxului live (minute agregate), care e mai mare. Ore (Zi): doar fluxul live. " +
        "An: luni din totalurile lunare ale prizelor sau suma zilelor. Restul casei = contor − prize (minim 0); " +
        "„≈” = în marja de eroare, max(15 W × ore, 3 % din casă). Sub-contoarele nu intră în casă.";

    private ReportPeriod _period;
    private DateOnly _today;
    private HouseReport? _report;
    private bool _noMain;
    private string? _error;
    private decimal _tariff;
    private int _chartKey;
    private List<Bar> _plugBars = new(), _restBars = new();
    private ApexChartOptions<Bar> _options = new();

    protected override async Task OnInitializedAsync()
    {
        _today = Reports.Today();
        _period = ReportPeriod.Containing(ReportGranularity.Month, _today);
        try { _tariff = (await KasaSettings.GetAsync(CancellationToken.None)).TariffRonPerKwh; }
        catch (Exception) { _tariff = 0; }
        await LoadAsync();
    }

    private async Task OnPeriodChanged(ReportPeriod p)
    {
        _period = p;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _today = Reports.Today();
            var requested = _period;
            var r = await Reports.GetHouseReportAsync(requested, CancellationToken.None);
            // A slower earlier request must not overwrite the period chosen since.
            if (requested != _period) return;
            _noMain = r is null;
            _report = r;
            _error = null;
            if (r is null) return;
            var labels = r.Buckets.Select(b => ReportFormat.BucketLabel(b, r.Period.Kind)).ToList();
            _plugBars = labels.Select((l, i) => new Bar(l, Dec(r.PlugsKwh[i]))).ToList();
            _restBars = labels.Select((l, i) => new Bar(l, Dec(r.RestKwh[i]))).ToList();
            _options = ChartOptions(r);
            _chartKey++;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private decimal Cost(double kwh) => (decimal)kwh * _tariff;

    private static decimal? Dec(double? v) => v is { } x ? Math.Round((decimal)x, 3) : null;

    private static string NoDataHint(HouseReport r) =>
        r.FirstHouseDay is { } f && r.Period.EndExclusive <= f ? $" (istoricul contorului începe pe {ReportFormat.Date(f)})" : "";

    private static ApexChartOptions<Bar> ChartOptions(HouseReport r)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var totals = string.Join(",", r.HouseKwh.Select(v => v is { } x ? x.ToString("0.000", inv) : "null"));
        return new ApexChartOptions<Bar>
        {
            Chart = new Chart { Stacked = true, Toolbar = new Toolbar { Show = false }, Animations = new Animations { Enabled = false } },
            PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = false } },
            DataLabels = new DataLabels { Enabled = false },
            Legend = new Legend { Show = true },
            Tooltip = new Tooltip
            {
                Shared = true,
                Intersect = false,
                X = new TooltipX
                {
                    Formatter = $"function(value, opts) {{ var t = [{totals}]; var i = opts ? opts.dataPointIndex : -1; return (i >= 0 && i < t.length && t[i] != null) ? value + ' — casă ' + t[i].toFixed(3) + ' kWh' : value + ' — fără date'; }}"
                },
                Y = new TooltipY { Formatter = "function(v) { return v == null ? '—' : v.toFixed(3) + ' kWh'; }" },
            },
        };
    }
}
