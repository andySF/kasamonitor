@using System.Globalization
@using KasaMonitor.Web.Ui
@using KasaMonitor.Workers
@using KasaMonitor.Core.Heating
@inject IKasaSettingsService KasaSettings
@inject IHeatingSettingsService HeatingSettings
@inject IClimateSettingsService ClimateSettings
@inject ReadingsRetentionService Retention
@inject IConfiguration Configuration
@inherits SettingsTabBase

@* /settings/aplicatie: what applies to the whole app, not to one vendor (tariffs, LAN discovery, live stream, data
   retention, appliance detection, degree days, Grafana). One „Salvează” for the tab; only these keys are written. *@
@if (_loaded is null)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Se încarcă…</p>
}
else
{
    <div class="row g-3">
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-cash-coin me-2"></i>Tarife</div>
                <div class="card-body">
                    <div class="row g-2 mb-1">
                        <div class="col-sm-6">
                            <label class="form-label" for="tariff">Curent (RON / kWh)</label>
                            <input class="form-control" id="tariff" @bind="_tariff" type="number" step="0.01" min="0" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="gasPrice">Gaz (RON / kWh)</label>
                            <input class="form-control" id="gasPrice" @bind="_gasPrice" type="number" step="0.001" min="0" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="gasFactor">Gaz: kWh / m³</label>
                            <input class="form-control" id="gasFactor" @bind="_gasFactor" type="number" step="0.01" min="@HeatingSettingsService.MinKwhPerM3" max="@HeatingSettingsService.MaxKwhPerM3" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="gasUnit">Gaz: unitate implicită</label>
                            <select class="form-select" id="gasUnit" @bind="_gasUnit">
                                <option value="m3">m³</option>
                                <option value="kWh">kWh</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-text">
                        Tarifele se aplică imediat (Acasă, Prize, Istoric, Centrală); o scumpire recalculează și trecutul. Factorul transformă m³ în kWh
                        pentru cost (uzual 10,5–10,6). Unitatea gazului vine din răspunsul centralei; cea de aici se folosește doar când lipsește.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-broadcast me-2"></i>Descoperire în rețea (TP-Link și Shelly)</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="autoDiscovery" @bind="_autoDiscovery" />
                        <label class="form-check-label" for="autoDiscovery">Descoperire automată</label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="interval">Interval descoperire (minute)</label>
                        <input class="form-control" id="interval" @bind="_intervalMin" type="number" min="@KasaSettingsService.MinIntervalMinutes" max="@KasaSettingsService.MaxIntervalMinutes" />
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="autoAdd" @bind="_autoAdd" />
                        <label class="form-check-label" for="autoAdd">Adaugă automat dispozitivele găsite</label>
                    </div>
                    <div class="mb-1">
                        <label class="form-label" for="poll">Interval interogare prize (secunde)</label>
                        <input class="form-control" id="poll" value="@_pollSec" readonly disabled aria-describedby="pollHelp" />
                    </div>
                    <div class="form-text" id="pollHelp">
                        Intervalul de interogare vine din configurație (<code>KasaMonitor__PollIntervalSeconds</code>, implicit 10) și se citește la pornire;
                        nu se schimbă de aici. Rețelele broadcast sunt în tabul <TabLink To="@KasaMonitor.Core.Devices.IntegrationKeys.TpLink">TP-Link</TabLink>,
                        mDNS-ul și adresele Shelly în tabul <TabLink To="@KasaMonitor.Core.Devices.IntegrationKeys.Shelly">Shelly</TabLink>.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-activity me-2"></i>Flux live</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="meterStream" @bind="_meterStream" />
                        <label class="form-check-label" for="meterStream">Flux live (contorul general la 1 s, prizele 1–10 s)</label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="meterInterval">Interval de bază (secunde, minim @KasaSettingsService.MinLiveIntervalSeconds): contorul general fix, prizele cel mai des</label>
                        <input class="form-control" id="meterInterval" @bind="_meterInterval" type="number" min="@KasaSettingsService.MinLiveIntervalSeconds" max="@KasaSettingsService.MaxLiveIntervalSeconds" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="burst">Salt al contorului general care readuce prizele la 1 s (W)</label>
                        <input class="form-control" id="burst" @bind="_burstW" type="number" min="@KasaSettingsService.MinBurstTriggerW" max="@KasaSettingsService.MaxBurstTriggerW" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="meterRetention">Păstrează eșantioanele brute ale fluxului (zile, 0 = nelimitat)</label>
                        <input class="form-control" id="meterRetention" @bind="_meterRetentionDays" type="number" min="0" max="@KasaSettingsService.MaxLiveRetentionDays" />
                    </div>
                    <div class="form-text">
                        Fluxul citește prizele și canalele cu bifa „flux 1 s” (pagina <a href="@DevicePages.Href()">Dispozitive</a>): contorul general la fiecare secundă, prizele la
                        1 s cât timp puterea se schimbă și până la 10 s când stau liniștite (înapoi la 1 s, timp de 60 s, când contorul general sare cu mai mult decât pragul de mai sus).
                        Un rând brut se scrie doar când puterea se schimbă (&gt; 1 W și &gt; 1 %) sau o dată pe minut; mediile pe minut se păstrează nelimitat.
                        La o retenție mai mică se cere confirmare.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-database me-2"></i>Date</div>
                <div class="card-body">
                    <label class="form-label" for="retention">Păstrează citirile brute (luni, 0 = nelimitat)</label>
                    <input class="form-control" id="retention" @bind="_retentionMonths" type="number" min="0" max="@KasaSettingsService.MaxRetentionMonths" />
                    <div class="form-text">
                        Citirile brute sunt valorile la fiecare interogare (implicit 10 s): ≈ 128 octeți/citire în SQLite, adică ≈ 1,1 MB pe priză pe zi,
                        ≈ 400 MB pe priză pe an. Istoricul zilnic (kWh/zi) și agregatele pe minut nu se șterg niciodată. La o valoare &gt; 0, citirile mai
                        vechi se șterg o dată pe zi; la o valoare mai mică se cere confirmare. Citirile centralei au retenția lor, în tabul
                        <TabLink To="@KasaMonitor.Core.Devices.IntegrationKeys.Viessmann">Viessmann</TabLink>.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-lightbulb me-2"></i>Consumatori detectați (NILM)</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="nilmEnabled" @bind="_nilmEnabled" />
                        <label class="form-check-label" for="nilmEnabled">Detectează consumatorii din puterea contorului general</label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="minEvent">Pragul unui eveniment (W, schimbare stabilă a puterii casei)</label>
                        <input class="form-control" id="minEvent" @bind="_minEventW" type="number" min="@KasaSettingsService.MinEventDeltaWMin" max="@KasaSettingsService.MinEventDeltaWMax" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="clusterDays">Fereastra regrupării de noapte (zile)</label>
                        <input class="form-control" id="clusterDays" @bind="_clusterDays" type="number" min="@KasaSettingsService.MinClusterWindowDays" max="@KasaSettingsService.MaxClusterWindowDays" />
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="mlEnabled" @bind="_mlEnabled" />
                        <label class="form-check-label" for="mlEnabled">Model ML (ML.NET) antrenat noaptea pe evenimentele etichetate</label>
                    </div>
                    <div class="form-text">
                        Pornirile și opririle din fluxul la 1 s al contorului general devin evenimente, grupate în semnături = consumatori; prizele etichetează
                        automat evenimentele lor. Pragul implicit e @KasaSettingsDefaults.DefaultMinEventDeltaW W. Regruparea și antrenarea rulează zilnic la 03:30.
                        Rezultatul e pe pagina <a href="/consumatori">Consumatori</a>.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-thermometer-sun me-2"></i>Climă și Grafana</div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label" for="cHdd">Baza gradelor-zile de încălzire (°C)</label>
                        <input class="form-control" id="cHdd" @bind="_hddBase" inputmode="decimal" autocomplete="off" />
                        <div class="form-text">
                            Pentru <a href="/history#clima">Istoric → Climă</a>: grade-zile = bază − temperatura medie de afară, în zilele cu media ≤ bază − 3 °C
                            (metoda Eurostat: bază 18 °C, prag 15 °C; implicit). Între @ClimateSettingsService.MinDegreeDaysBaseC.ToString("0", CultureInfo.InvariantCulture) și @ClimateSettingsService.MaxDegreeDaysBaseC.ToString("0", CultureInfo.InvariantCulture) °C.
                        </div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label" for="grafanaUrl">Grafana (link din subsolul paginii Acasă)</label>
                        <input class="form-control" id="grafanaUrl" @bind="_grafanaUrl" placeholder="http://192.168.1.10:3000/d/kasamonitor" />
                        <div class="form-text">Gol = fără link.</div>
                    </div>
                </div>
            </div>
        </div>

        @if (_pendingPlan is not null || _pendingLivePlan is not null)
        {
            <div class="col-12">
                <div class="alert alert-warning mb-0" role="alert">
                    @if (_pendingPlan is { NeedsConfirmation: true } plan)
                    {
                        <p class="mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Se vor șterge <b>@plan.RowsToDelete.ToString("N0")</b> citiri mai vechi de <b>@plan.CutoffUtc!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</b>. Confirmi?</p>
                    }
                    @if (_pendingLivePlan is { NeedsConfirmation: true } live)
                    {
                        <p class="mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Se vor șterge <b>@live.RowsToDelete.ToString("N0")</b> eșantioane brute ale fluxului live mai vechi de <b>@live.CutoffUtc!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</b> (mediile pe minut rămân). Confirmi?</p>
                    }
                    <button class="btn btn-danger btn-sm me-2" @onclick="ConfirmAsync" disabled="@_deleting">
                        <i class="bi bi-trash me-1"></i>@(_deleting ? "Se șterge…" : "Da, salvează și șterge")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm me-2" @onclick="CancelConfirm" disabled="@_deleting"><i class="bi bi-x-lg me-1"></i>Renunță</button>
                    <span class="small text-secondary">Fără confirmare nu se salvează nimic și nu se șterge nimic.</span>
                </div>
            </div>
        }

        <div class="col-12 d-flex align-items-center gap-3">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(_pendingPlan is not null || _pendingLivePlan is not null)"><i class="bi bi-save me-1"></i>Salvează „Aplicație”</button>
            @if (IsDirty) { <span class="text-warning-emphasis small"><i class="bi bi-pencil-square me-1"></i>modificări nesalvate</span> }
            @if (_saved) { <span class="text-success"><i class="bi bi-check-circle me-1"></i>Salvat.@(_deletedMessage is null ? "" : " " + _deletedMessage)</span> }
            @if (_error is not null) { <span class="text-danger"><i class="bi bi-x-circle me-1"></i>@_error</span> }
        </div>
        <div class="col-12 form-text">Se aplică fără repornire (la următorul ciclu; fluxul în ≤ 10 s). Se salvează doar câmpurile din acest tab.</div>
    </div>
}

@code {
    private string? _loaded;
    private bool _saved;
    private string? _error;
    private decimal _tariff;
    private decimal _gasPrice;
    private double _gasFactor;
    private string _gasUnit = "m3";
    private bool _autoDiscovery;
    private int _intervalMin;
    private bool _autoAdd;
    private int _pollSec;
    private bool _meterStream;
    private int _meterInterval;
    private int _burstW;
    private int _meterRetentionDays;
    private int _retentionMonths;
    private bool _nilmEnabled;
    private int _minEventW;
    private int _clusterDays;
    private bool _mlEnabled;
    private string _hddBase = "";
    private string _grafanaUrl = "";
    private RetentionPlan? _pendingPlan;
    private RetentionPlan? _pendingLivePlan;
    private bool _deleting;
    private string? _deletedMessage;

    public override bool IsDirty => _loaded is not null && _loaded != Fingerprint();

    private string Fingerprint() => string.Join("|", _tariff.ToString(CultureInfo.InvariantCulture), _gasPrice.ToString(CultureInfo.InvariantCulture),
        _gasFactor.ToString(CultureInfo.InvariantCulture), _gasUnit, _autoDiscovery, _intervalMin, _autoAdd, _meterStream, _meterInterval, _burstW,
        _meterRetentionDays, _retentionMonths, _nilmEnabled, _minEventW, _clusterDays, _mlEnabled, _hddBase.Trim(), _grafanaUrl.Trim());

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var s = await KasaSettings.GetAsync(CancellationToken.None);
        var h = await HeatingSettings.GetAsync(CancellationToken.None);
        var c = await ClimateSettings.GetAsync(CancellationToken.None);
        _tariff = s.TariffRonPerKwh;
        _gasPrice = h.GasPricePerKwh;
        _gasFactor = h.GasKwhPerM3;
        _gasUnit = h.GasUnitText;
        _autoDiscovery = s.AutoDiscoveryEnabled;
        _intervalMin = s.AutoDiscoveryIntervalMinutes;
        _autoAdd = s.AutoAddDiscoveredPlugs;
        _pollSec = Configuration.GetValue("KasaMonitor:PollIntervalSeconds", 10);
        _meterStream = s.LiveStreamEnabled;
        _meterInterval = s.LiveStreamIntervalSeconds;
        _burstW = s.LiveBurstTriggerW;
        _meterRetentionDays = s.LiveRawRetentionDays;
        _retentionMonths = s.ReadingsRetentionMonths;
        _nilmEnabled = s.NilmEnabled;
        _minEventW = s.MinEventDeltaW;
        _clusterDays = s.ClusterWindowDays;
        _mlEnabled = s.MlEnabled;
        _hddBase = c.HeatingDegreeDaysBaseC.ToString("0.#", CultureInfo.InvariantCulture);
        _grafanaUrl = s.GrafanaUrl;
        _loaded = Fingerprint();
    }

    private async Task SaveAsync()
    {
        _error = null;
        _deletedMessage = null;
        if (ClimateSettingsService.ParseCoordinate(_hddBase) is not { } hdd || hdd < ClimateSettingsService.MinDegreeDaysBaseC || hdd > ClimateSettingsService.MaxDegreeDaysBaseC)
        {
            _error = $"Baza gradelor-zile trebuie să fie un număr între {ClimateSettingsService.MinDegreeDaysBaseC:0} și {ClimateSettingsService.MaxDegreeDaysBaseC:0} °C.";
            return;
        }
        // Invalid values are refused before the retention question (and again, before any write, in SaveSettingsAsync).
        if ((HeatingSettingsService.Validate(new HeatingSettingsUpdate(GasPricePerKwh: _gasPrice, GasKwhPerM3: _gasFactor))
             ?? KasaSettingsService.ValidateGrafanaUrl(_grafanaUrl)) is { } invalid)
        {
            _error = invalid;
            return;
        }
        _retentionMonths = Math.Clamp(_retentionMonths, 0, KasaSettingsService.MaxRetentionMonths);
        _meterRetentionDays = Math.Clamp(_meterRetentionDays, 0, KasaSettingsService.MaxLiveRetentionDays);

        // Ask before anything is saved when a new retention would delete existing readings or live samples.
        var plan = await Retention.PlanAsync(_retentionMonths, CancellationToken.None);
        var live = await Retention.PlanLiveRawAsync(_meterRetentionDays, CancellationToken.None);
        if (plan.NeedsConfirmation || live.NeedsConfirmation)
        {
            _pendingPlan = plan;
            _pendingLivePlan = live;
            return;
        }
        if (await SaveSettingsAsync(hdd)) await AfterSaveAsync();
    }

    private void CancelConfirm()
    {
        _pendingPlan = null;
        _pendingLivePlan = null;
    }

    private async Task ConfirmAsync()
    {
        if (_pendingPlan is not { } plan || _pendingLivePlan is not { } live) return;
        if (ClimateSettingsService.ParseCoordinate(_hddBase) is not { } hdd) return;
        _retentionMonths = plan.Months;
        _meterRetentionDays = live.Months;
        _deleting = true;
        StateHasChanged();
        try
        {
            if (!await SaveSettingsAsync(hdd)) return;
            var parts = new List<string>();
            if (plan.NeedsConfirmation)
                parts.Add($"{await Retention.ApplyAsync(plan.Months, CancellationToken.None):N0} citiri");
            if (live.NeedsConfirmation)
                parts.Add($"{await Retention.ApplyLiveRawAsync(live.Months, CancellationToken.None):N0} eșantioane brute");
            _deletedMessage = $"Au fost șterse {string.Join(" și ", parts)}.";
        }
        finally
        {
            _deleting = false;
            _pendingPlan = null;
            _pendingLivePlan = null;
        }
        await AfterSaveAsync();
    }

    /// <summary>Only the keys of this tab (R1): the other tabs' keys are left as stored.</summary>
    private async Task<bool> SaveSettingsAsync(double hdd)
    {
        // R1: nothing is written unless every part is valid (the tariff and discovery keys are written first).
        var gas = new HeatingSettingsUpdate(GasPricePerKwh: _gasPrice, GasUnit: _gasUnit, GasKwhPerM3: _gasFactor);
        if (HeatingSettingsService.Validate(gas) is { } gasError)
        {
            _error = gasError;
            return false;
        }
        try
        {
            await KasaSettings.SaveAsync(new KasaSettingsUpdate(
                AutoDiscoveryEnabled: _autoDiscovery,
                AutoDiscoveryIntervalMinutes: _intervalMin,
                AutoAddDiscoveredPlugs: _autoAdd,
                ReadingsRetentionMonths: _retentionMonths,
                LiveStreamEnabled: _meterStream,
                LiveStreamIntervalSeconds: _meterInterval,
                LiveRawRetentionDays: _meterRetentionDays,
                LiveBurstTriggerW: _burstW,
                NilmEnabled: _nilmEnabled,
                MinEventDeltaW: _minEventW,
                ClusterWindowDays: _clusterDays,
                MlEnabled: _mlEnabled,
                GrafanaUrl: _grafanaUrl,
                TariffRonPerKwh: _tariff), CancellationToken.None);
            await HeatingSettings.SaveAsync(gas, CancellationToken.None);
            await ClimateSettings.SaveHeatingDegreeDaysBaseAsync(hdd, CancellationToken.None);
            return true;
        }
        catch (Exception ex) when (ex is FormatException or ArgumentException)
        {
            _error = ex.Message;
            return false;
        }
    }

    private async Task AfterSaveAsync()
    {
        await LoadAsync();
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
