@page "/settings"
@rendermode InteractiveServer
@using KasaMonitor.Workers
@inject IServiceScopeFactory ScopeFactory
@inject IKasaSettingsService KasaSettings
@inject ReadingsRetentionService Retention
@inject PrometheusRemoteWriter RemoteWriter
@implements IDisposable

<PageTitle>KasaMonitor — Setări</PageTitle>
<h1 class="h3 mb-3"><i class="bi bi-gear me-2"></i>Setări</h1>

@if (_loading)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Se încarcă…</p>
}
else
{
    <div class="row g-3" style="max-width: 1100px;">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-broadcast me-2"></i>Descoperire</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="autoDiscovery" @bind="_autoDiscovery" />
                        <label class="form-check-label" for="autoDiscovery">Descoperire automată</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="interval">Interval descoperire (minute)</label>
                        <input class="form-control" id="interval" @bind="_intervalMin" type="number" min="@KasaSettingsService.MinIntervalMinutes" max="@KasaSettingsService.MaxIntervalMinutes" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="broadcast">Rețele broadcast (separate prin virgulă)</label>
                        <input class="form-control" id="broadcast" @bind="_broadcast" placeholder="192.168.1.255" />
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="autoAdd" @bind="_autoAdd" />
                        <label class="form-check-label" for="autoAdd">Adaugă automat prizele găsite</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-cloud me-2"></i>Cont TP-Link (prize Tapo, KLAP / AES)</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="tapoUser">Utilizator (e-mail)</label>
                        <input class="form-control" id="tapoUser" @bind="_tapoUser" autocomplete="off" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="tapoPassword">Parolă</label>
                        <input class="form-control" id="tapoPassword" @bind="_tapoPassword" type="password" autocomplete="new-password"
                               placeholder="@(_hasTapoPassword ? "•••••••• (setată; lasă gol ca să rămână)" : "nesetată")" />
                    </div>
                    @if (_hasTapoPassword)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="clearPw" @bind="_clearTapoPassword" />
                            <label class="form-check-label" for="clearPw">Șterge parola</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-speedometer me-2"></i>Shelly Gen2 / Gen3 (contoare și prize)</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="shellyDiscovery" @bind="_shellyDiscovery" />
                        <label class="form-check-label" for="shellyDiscovery">Descoperire Shelly (mDNS <code>_shelly._tcp</code> + adresele de mai jos)</label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="shellyPassword">Parolă Shelly (utilizator <code>admin</code>, opțional)</label>
                        <input class="form-control" id="shellyPassword" @bind="_shellyPassword" type="password" autocomplete="new-password"
                               placeholder="@(_hasShellyPassword ? "•••••••• (setată; lasă gol ca să rămână)" : "nesetată (doar pentru dispozitivele cu autentificare)")" />
                    </div>
                    @if (_hasShellyPassword)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="clearShellyPw" @bind="_clearShellyPassword" />
                            <label class="form-check-label" for="clearShellyPw">Șterge parola Shelly</label>
                        </div>
                    }
                    <div class="mb-1">
                        <label class="form-label" for="shellyHosts">Adrese de probat (opțional)</label>
                        <input class="form-control" id="shellyHosts" @bind="_shellyProbeHosts" placeholder="192.168.1.141, 192.168.1.150-160, 10.0.5.0/24" />
                    </div>
                    <div class="form-text">
                        Pentru dispozitive pe care mDNS nu le găsește (alt subnet, mDNS oprit): IP-uri, intervale sau CIDR, separate prin virgulă;
                        fiecare adresă e întrebată la fiecare descoperire cu <code>Shelly.GetDeviceInfo</code> (timeout 1 s). Aplicația citește;
                        singura scriere e comanda releului (<code>Switch.Set</code>, cu confirmare), nu schimbă configurația.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-activity me-2"></i>Flux live și releu</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="meterStream" @bind="_meterStream" />
                        <label class="form-check-label" for="meterStream">Flux live (contorul general la 1 s, prizele 1–10 s)</label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="meterInterval">Interval de bază (secunde, minim @KasaSettingsService.MinLiveIntervalSeconds): contorul general fix, prizele cel mai des</label>
                        <input class="form-control" id="meterInterval" @bind="_meterInterval" type="number" min="@KasaSettingsService.MinLiveIntervalSeconds" max="@KasaSettingsService.MaxLiveIntervalSeconds" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="meterRetention">Păstrează eșantioanele brute ale fluxului (zile, 0 = nelimitat)</label>
                        <input class="form-control" id="meterRetention" @bind="_meterRetentionDays" type="number" min="0" max="@KasaSettingsService.MaxLiveRetentionDays" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="burst">Salt al contorului general care readuce prizele la 1 s (W)</label>
                        <input class="form-control" id="burst" @bind="_burstW" type="number" min="@KasaSettingsService.MinBurstTriggerW" max="@KasaSettingsService.MaxBurstTriggerW" />
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="allowRelay" @bind="_allowRelay" />
                        <label class="form-check-label" for="allowRelay">Permite comanda releului (Shelly <code>Switch.Set</code>)</label>
                    </div>
                    <div class="form-text">
                        Fluxul citește prizele și canalele cu bifa „flux 1 s” (pagina Prize): contorul general la fiecare secundă, prizele la
                        1 s cât timp puterea se schimbă și până la 10 s când stau liniștite (înapoi la 1 s, timp de 60 s, când contorul general sare cu mai mult decât pragul de mai sus între două secunde).
                        Un rând brut se scrie doar când puterea se schimbă (&gt; 1 W și &gt; 1 %) sau o dată pe minut; mediile pe minut se calculează
                        din toate citirile și se păstrează nelimitat. Rândurile brute se șterg o dată pe zi după numărul de zile de mai sus; la o
                        valoare mai mică se cere confirmare. Când comanda releului e oprită, comutatorul Pornit/Oprit nu mai apare; fiecare comandă
                        cere confirmare și e trecută în jurnal. Aplicația nu are autentificare: expune-o doar în LAN.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-diagram-3 me-2"></i>Integrare: Prometheus remote write</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="rwOn" @bind="_rwEnabled" />
                        <label class="form-check-label" for="rwOn">Trimite eșantioanele fluxului live (<code>kasa_live_*</code>) la Prometheus</label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="rwUrl">Adresa remote write</label>
                        <input class="form-control" id="rwUrl" @bind="_rwUrl" placeholder="http://192.168.1.10:9090/api/v1/write" />
                    </div>
                    <div class="row g-2 mb-1">
                        <div class="col-sm-6">
                            <label class="form-label" for="rwUser">Utilizator (opțional, basic auth)</label>
                            <input class="form-control" id="rwUser" @bind="_rwUser" autocomplete="off" placeholder="@(_hasRwAuth ? "•••• (setat; lasă gol ca să rămână)" : "nesetat")" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="rwPassword">Parolă</label>
                            <input class="form-control" id="rwPassword" @bind="_rwPassword" type="password" autocomplete="new-password" placeholder="@(_hasRwAuth ? "•••••••• (setată)" : "nesetată")" />
                        </div>
                    </div>
                    @if (_hasRwAuth)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="clearRw" @bind="_clearRwAuth" />
                            <label class="form-check-label" for="clearRw">Șterge utilizatorul și parola</label>
                        </div>
                    }
                    @{ var st = RemoteWriter.Status; }
                    <div class="small mt-2">
                        <span class="badge @(st.Enabled ? (st.LastError is null ? "text-bg-success" : "text-bg-warning") : "text-bg-secondary")">@(st.Enabled ? (st.LastError is null ? "activ" : "eroare") : "oprit")</span>
                        <span class="ms-2">ultimul succes: @(st.LastSuccessUtc is { } ls ? KasaMonitor.Web.Ui.UiFormat.RelativeRo(ls, DateTimeOffset.UtcNow) : "—")</span>
                        <span class="ms-2">trimise: @st.SentSamples.ToString("N0")</span>
                        <span class="ms-2">pierdute: @st.DroppedSamples.ToString("N0")</span>
                        <span class="ms-2">eșecuri: @st.Failures.ToString("N0")</span>
                        <span class="ms-2">în coadă: @st.Buffered.ToString("N0")</span>
                        @if (st.LastError is not null) { <div class="text-danger mt-1">@st.LastError</div> }
                    </div>
                    <div class="form-text">
                        Trimite doar eșantioanele scrise și în baza de date (la schimbare &gt; 1 W și &gt; 1 % sau o dată pe minut), cu ora reală a
                        eșantionului: <code>kasa_live_power_w</code>, iar unde există și <code>kasa_live_voltage_v</code>, <code>kasa_live_current_a</code>,
                        <code>kasa_live_power_factor</code>. Prometheus trebuie pornit cu <code>--web.enable-remote-write-receiver</code>. Coada ține
                        cel mult 5 minute; ce e mai vechi se pierde (contorul „pierdute”).
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <HeatingSettingsCard />
        </div>

        <div class="col-lg-6">
            <MieleSettingsCard />
        </div>

        <div class="col-lg-6">
            <GoveeSettingsCard />
        </div>

        <div class="col-lg-6">
            <ClimateSettingsCard />
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-lightbulb me-2"></i>Consumatori detectați (NILM)</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="nilmEnabled" @bind="_nilmEnabled" />
                        <label class="form-check-label" for="nilmEnabled">Detectează consumatorii din puterea contorului general</label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="minEvent">Pragul unui eveniment (W, schimbare stabilă a puterii casei)</label>
                        <input class="form-control" id="minEvent" @bind="_minEventW" type="number" min="@KasaSettingsService.MinEventDeltaWMin" max="@KasaSettingsService.MinEventDeltaWMax" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="clusterDays">Fereastra regrupării de noapte (zile)</label>
                        <input class="form-control" id="clusterDays" @bind="_clusterDays" type="number" min="@KasaSettingsService.MinClusterWindowDays" max="@KasaSettingsService.MaxClusterWindowDays" />
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="mlEnabled" @bind="_mlEnabled" />
                        <label class="form-check-label" for="mlEnabled">Model ML (ML.NET) antrenat noaptea pe evenimentele etichetate</label>
                    </div>
                    <div class="form-text">
                        Pornirile și opririle din fluxul la 1 s al contorului general devin evenimente (ΔP, ΔQ, vârful de pornire), grupate în
                        semnături = consumatori; prizele etichetează automat evenimentele lor (o priză cu sarcină variabilă, ex. UPS, se exclude singură).
                        Pragul implicit e @KasaSettingsDefaults.DefaultMinEventDeltaW W: casa măsurată variază cu ~17 W pe secundă, iar un prag mai mic umple pagina
                        cu evenimente mărunte. Regruparea și antrenarea modelului rulează zilnic la 03:30 peste ultimele zile de mai sus.
                        Rezultatul e pe pagina <a href="/consumatori">Consumatori</a>.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-sliders me-2"></i>Altele</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="tariff">Tarif (RON / kWh)</label>
                        <input class="form-control" id="tariff" @bind="_tariff" type="number" step="0.01" />
                    </div>
                    <div class="mb-1">
                        <label class="form-label" for="poll">Interval interogare (secunde)</label>
                        <input class="form-control" id="poll" @bind="_pollSec" type="number" min="5" max="300" />
                    </div>
                    <div class="form-text">Tariful se aplică imediat (costurile din Dashboard și History); intervalul de interogare se citește la pornire din variabilele de mediu.</div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-database me-2"></i>Date</div>
                <div class="card-body">
                    <label class="form-label" for="retention">Păstrează citirile brute (luni, 0 = nelimitat)</label>
                    <input class="form-control" id="retention" @bind="_retentionMonths" type="number" min="0" max="@KasaSettingsService.MaxRetentionMonths" />
                    <div class="form-text">
                        Citirile brute sunt valorile la fiecare interogare (implicit 10 s): ≈ 128 octeți/citire în SQLite, adică ≈ 1,1 MB pe priză pe zi,
                        ≈ 400 MB pe priză pe an (6 prize ≈ 2,4 GB/an). Istoricul zilnic (kWh/zi) și agregatele pe minut (≈ 65 MB pe priză pe an)
                        nu se șterg niciodată, indiferent de această setare. La o valoare &gt; 0, citirile mai vechi se șterg o dată pe zi.
                    </div>
                </div>
            </div>
        </div>

        @if (_pendingPlan is not null || _pendingLivePlan is not null)
        {
            <div class="col-12">
                <div class="alert alert-warning mb-0">
                    @if (_pendingPlan is { NeedsConfirmation: true } plan)
                    {
                        <p class="mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Se vor șterge <b>@plan.RowsToDelete.ToString("N0")</b> citiri mai vechi de <b>@plan.CutoffUtc!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</b>. Confirmi?</p>
                    }
                    @if (_pendingLivePlan is { NeedsConfirmation: true } live)
                    {
                        <p class="mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Se vor șterge <b>@live.RowsToDelete.ToString("N0")</b> eșantioane brute ale fluxului live mai vechi de <b>@live.CutoffUtc!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</b> (mediile pe minut rămân). Confirmi?</p>
                    }
                    <button class="btn btn-danger btn-sm me-2" @onclick="ConfirmAsync" disabled="@_deleting">
                        <i class="bi bi-trash me-1"></i>@(_deleting ? "Se șterge…" : "Da, salvează și șterge")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm me-2" @onclick="CancelConfirm" disabled="@_deleting"><i class="bi bi-x-lg me-1"></i>Renunță</button>
                    <span class="small text-secondary">Fără confirmare nu se salvează nimic și nu se șterge nimic.</span>
                </div>
            </div>
        }

        <div class="col-12 d-flex align-items-center gap-3">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(_pendingPlan is not null || _pendingLivePlan is not null)"><i class="bi bi-save me-1"></i>Salvează</button>
            @if (_saved) { <span class="text-success"><i class="bi bi-check-circle me-1"></i>Salvat.@(_deletedMessage is null ? "" : " " + _deletedMessage)</span> }
            @if (_error is not null) { <span class="text-danger"><i class="bi bi-x-circle me-1"></i>@_error</span> }
        </div>
        <div class="col-12 form-text">Setările de descoperire, contul TP-Link, setările Shelly, fluxul live și retenția se aplică fără repornire (la următorul ciclu; fluxul în ≤ 10 s).</div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saved;
    private string? _error;
    private decimal _tariff;
    private int _pollSec;
    private bool _autoDiscovery;
    private int _intervalMin;
    private string _broadcast = "";
    private bool _autoAdd;
    private string _tapoUser = "";
    private string _tapoPassword = "";
    private bool _hasTapoPassword;
    private bool _clearTapoPassword;
    private int _retentionMonths;
    private bool _shellyDiscovery;
    private string _shellyPassword = "";
    private bool _hasShellyPassword;
    private bool _clearShellyPassword;
    private string _shellyProbeHosts = "";
    private bool _meterStream;
    private int _meterInterval;
    private int _meterRetentionDays;
    private bool _allowRelay;
    private int _burstW;
    private bool _rwEnabled;
    private string _rwUrl = "";
    private string _rwUser = "";
    private string _rwPassword = "";
    private bool _hasRwAuth;
    private bool _clearRwAuth;
    private bool _nilmEnabled;
    private int _minEventW;
    private int _clusterDays;
    private bool _mlEnabled;
    private System.Threading.Timer? _statusTimer;
    private RetentionPlan? _pendingPlan;
    private RetentionPlan? _pendingLivePlan;
    private bool _deleting;
    private string? _deletedMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
        // Remote write status (sent / dropped / last success) refreshed every 5 s.
        _statusTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 5000, 5000);
    }

    public void Dispose() => _statusTimer?.Dispose();

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<ISettingsRepository>();

        var tariffStr = await repo.GetAsync("TariffRonPerKwh", CancellationToken.None);
        _tariff = decimal.TryParse(tariffStr, System.Globalization.CultureInfo.InvariantCulture, out var t) ? t : 1.30m;

        var pollStr = await repo.GetAsync("PollIntervalSeconds", CancellationToken.None);
        _pollSec = int.TryParse(pollStr, out var p) ? p : 10;

        var s = await KasaSettings.GetAsync(CancellationToken.None);
        _autoDiscovery = s.AutoDiscoveryEnabled;
        _intervalMin = s.AutoDiscoveryIntervalMinutes;
        _broadcast = s.BroadcastNetworks;
        _autoAdd = s.AutoAddDiscoveredPlugs;
        _tapoUser = s.TapoUsername;
        _hasTapoPassword = s.HasTapoPassword;
        _tapoPassword = "";
        _clearTapoPassword = false;
        _retentionMonths = s.ReadingsRetentionMonths;
        _shellyDiscovery = s.ShellyDiscoveryEnabled;
        _hasShellyPassword = s.HasShellyPassword;
        _shellyPassword = "";
        _clearShellyPassword = false;
        _shellyProbeHosts = s.ShellyProbeHosts;
        _meterStream = s.LiveStreamEnabled;
        _meterInterval = s.LiveStreamIntervalSeconds;
        _meterRetentionDays = s.LiveRawRetentionDays;
        _allowRelay = s.AllowRelayControl;
        _burstW = s.LiveBurstTriggerW;
        _rwEnabled = s.RemoteWriteEnabled;
        _rwUrl = s.RemoteWriteUrl;
        _hasRwAuth = s.HasRemoteWriteAuth;
        _rwUser = "";
        _rwPassword = "";
        _clearRwAuth = false;
        _nilmEnabled = s.NilmEnabled;
        _minEventW = s.MinEventDeltaW;
        _clusterDays = s.ClusterWindowDays;
        _mlEnabled = s.MlEnabled;
    }

    private async Task SaveAsync()
    {
        _error = null;
        _deletedMessage = null;
        var (_, invalid) = KasaSettingsService.ParseBroadcastNetworks(_broadcast);
        if (invalid.Count > 0)
        {
            _error = $"Adrese broadcast invalide: {string.Join(", ", invalid)}";
            return;
        }
        var (_, badShelly) = KasaMonitor.Core.Protocol.Shelly.ShellySupport.ParseProbeHosts(_shellyProbeHosts);
        if (badShelly.Count > 0)
        {
            _error = $"Adrese Shelly invalide: {string.Join(", ", badShelly)}";
            return;
        }
        _retentionMonths = Math.Clamp(_retentionMonths, 0, KasaSettingsService.MaxRetentionMonths);

        _meterRetentionDays = Math.Clamp(_meterRetentionDays, 0, KasaSettingsService.MaxLiveRetentionDays);

        // Ask before anything is saved when a new retention would delete existing readings or live samples.
        var plan = await Retention.PlanAsync(_retentionMonths, CancellationToken.None);
        var live = await Retention.PlanLiveRawAsync(_meterRetentionDays, CancellationToken.None);
        if (plan.NeedsConfirmation || live.NeedsConfirmation)
        {
            _pendingPlan = plan;
            _pendingLivePlan = live;
            return;
        }
        await SaveCoreAsync();
    }

    private void CancelConfirm()
    {
        _pendingPlan = null;
        _pendingLivePlan = null;
    }

    private async Task ConfirmAsync()
    {
        if (_pendingPlan is not { } plan || _pendingLivePlan is not { } live) return;
        _retentionMonths = plan.Months;
        _meterRetentionDays = live.Months;
        _deleting = true;
        StateHasChanged();
        try
        {
            if (!await SaveSettingsAsync()) return;
            var parts = new List<string>();
            if (plan.NeedsConfirmation)
                parts.Add($"{await Retention.ApplyAsync(plan.Months, CancellationToken.None):N0} citiri");
            if (live.NeedsConfirmation)
                parts.Add($"{await Retention.ApplyLiveRawAsync(live.Months, CancellationToken.None):N0} eșantioane brute");
            _deletedMessage = $"Au fost șterse {string.Join(" și ", parts)}.";
        }
        finally
        {
            _deleting = false;
            _pendingPlan = null;
            _pendingLivePlan = null;
        }
        await AfterSaveAsync();
    }

    private async Task SaveCoreAsync()
    {
        if (await SaveSettingsAsync()) await AfterSaveAsync();
    }

    private async Task<bool> SaveSettingsAsync()
    {
        try
        {
            await KasaSettings.SaveAsync(new KasaSettingsUpdate(
                _autoDiscovery, _intervalMin, _broadcast, _autoAdd, _tapoUser,
                NewTapoPassword: _tapoPassword, ClearTapoPassword: _clearTapoPassword,
                ReadingsRetentionMonths: _retentionMonths,
                ShellyDiscoveryEnabled: _shellyDiscovery,
                ShellyProbeHosts: _shellyProbeHosts,
                NewShellyPassword: _shellyPassword,
                ClearShellyPassword: _clearShellyPassword,
                LiveStreamEnabled: _meterStream,
                LiveStreamIntervalSeconds: _meterInterval,
                LiveRawRetentionDays: _meterRetentionDays,
                AllowRelayControl: _allowRelay,
                LiveBurstTriggerW: _burstW,
                RemoteWriteEnabled: _rwEnabled,
                RemoteWriteUrl: _rwUrl,
                NewRemoteWriteUser: _rwUser,
                NewRemoteWritePassword: _rwPassword,
                ClearRemoteWriteAuth: _clearRwAuth,
                NilmEnabled: _nilmEnabled,
                MinEventDeltaW: _minEventW,
                ClusterWindowDays: _clusterDays,
                MlEnabled: _mlEnabled), CancellationToken.None);
            await RemoteWriter.RefreshSettingsAsync(CancellationToken.None);
        }
        catch (FormatException ex)
        {
            _error = ex.Message;
            return false;
        }

        using (var scope = ScopeFactory.CreateScope())
        {
            var repo = scope.ServiceProvider.GetRequiredService<ISettingsRepository>();
            await repo.SetAsync("TariffRonPerKwh", _tariff.ToString(System.Globalization.CultureInfo.InvariantCulture), CancellationToken.None);
            await repo.SetAsync("PollIntervalSeconds", _pollSec.ToString(), CancellationToken.None);
        }
        return true;
    }

    private async Task AfterSaveAsync()
    {
        await LoadAsync();
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
