@page "/settings"
@page "/settings/{Tab}"
@rendermode InteractiveServer
@using KasaMonitor.Web.Ui
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@* /settings/{tab}: „Aplicație” and „Export” (the app itself), then one tab per integration (registry Integrations).
   Each tab has its own address (deep links), renders alone and saves only its own keys. Leaving a tab with unsaved
   changes asks first: the tab links and the links inside a tab (TabLink) go through Select on the server; a reload or
   closing the browser tab asks through the browser (ConfirmExternalNavigation, armed by the tab's DirtyChanged). *@
<PageTitle>KasaMonitor — Setări</PageTitle>
<h1 class="h3 mb-3"><i class="bi bi-gear me-2"></i>Setări</h1>

<CascadingValue Value="_navigation" IsFixed="true">
<div class="settings-tabs mb-3">
    <ul class="nav nav-tabs flex-wrap" role="tablist" aria-label="Taburile setărilor">
        @foreach (var t in SettingsTabs.All)
        {
            var active = t.Key == Current.Key;
            <li class="nav-item" role="presentation">
                <TabLink To="@t.Key" class="@(active ? "nav-link active" : "nav-link")" role="tab" id="@("tab-" + t.Key)"
                         aria-selected="@(active ? "true" : "false")" aria-controls="settings-panel">
                    <i class="bi @t.Icon me-1" aria-hidden="true"></i>@t.Name
                </TabLink>
            </li>
        }
    </ul>
</div>

@if (_pendingTab is { } pending)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="alertdialog" aria-labelledby="unsavedText">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span id="unsavedText">Tabul „@Current.Name” are modificări nesalvate. Le salvezi întâi sau renunți la ele?</span>
        <button class="btn btn-outline-secondary btn-sm ms-auto" @onclick="Stay"><i class="bi bi-arrow-left me-1"></i>Rămân aici</button>
        <button class="btn btn-warning btn-sm" @onclick="Leave">
            <i class="bi bi-x-lg me-1"></i>Renunț la modificări și deschid „@(SettingsTabs.Get(pending)?.Name)”
        </button>
    </div>
}

<div role="tabpanel" id="settings-panel" aria-labelledby="tab-@Current.Key" style="max-width: 1200px;">
    <DynamicComponent @key="Current.Key" Type="Current.Component" @ref="_panel" />
</div>
</CascadingValue>
<NavigationLock ConfirmExternalNavigation="@Dirty" />

@code {
    /// <summary>The tab from the address; empty or unknown = „Aplicație”.</summary>
    [Parameter] public string? Tab { get; set; }

    private DynamicComponent? _panel;
    private ISettingsTab? _watched;
    /// <summary>The tab the user wanted to open while the current one had unsaved changes.</summary>
    private string? _pendingTab;

    private SettingsTabs.Tab Current => SettingsTabs.Get(Tab) ?? SettingsTabs.All[0];

    private bool Dirty => _panel?.Instance is ISettingsTab { IsDirty: true };

    protected override void OnParametersSet()
    {
        _pendingTab = null;
    }

    /// <summary>Follows the current tab's dirty flag, so the reload / close confirmation is armed as soon as a field changes.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        var tab = _panel?.Instance as ISettingsTab;
        if (ReferenceEquals(tab, _watched)) return;
        if (_watched is not null) _watched.DirtyChanged -= OnDirtyChanged;
        _watched = tab;
        if (_watched is not null) _watched.DirtyChanged += OnDirtyChanged;
    }

    private void OnDirtyChanged() => InvokeAsync(StateHasChanged);

    private SettingsNavigation? _navigation;

    protected override void OnInitialized() => _navigation = new SettingsNavigation(SelectAsync);

    /// <summary>A tab link was clicked (its default and the enhanced navigation are off): ask first when the tab has unsaved changes.</summary>
    private async Task SelectAsync(string key, bool newWindow)
    {
        var url = SettingsTabs.Href(key);
        if (newWindow)
        {
            await JS.InvokeVoidAsync("open", url, "_blank");
            return;
        }
        if (key == Current.Key) return;
        if (Dirty)
        {
            _pendingTab = key;
            StateHasChanged();   // the click is TabLink's event: re-render the page for the question
            return;
        }
        Nav.NavigateTo(url);
    }

    private void Stay() => _pendingTab = null;

    private void Leave()
    {
        if (_pendingTab is not { } key) return;
        _pendingTab = null;
        Nav.NavigateTo(SettingsTabs.Href(key));
    }

    public void Dispose()
    {
        if (_watched is not null) _watched.DirtyChanged -= OnDirtyChanged;
    }
}
