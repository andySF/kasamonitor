<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>KasaMonitor.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.*" />
    <!-- Microsoft.Data.SqlClient brings System.Security.Cryptography.Pkcs 9.0.11 (NU1902/NU1903 advisories); the patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KasaMonitor.Core\KasaMonitor.Core.csproj" />
  </ItemGroup>
</Project>
