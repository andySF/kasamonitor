@page "/aparate"
@rendermode InteractiveServer
@using KasaMonitor.Workers
@using KasaMonitor.Core.Miele
@using KasaMonitor.Web.Ui
@inject IServiceScopeFactory ScopeFactory
@inject IMieleSettingsService MieleSettings
@inject MieleAuthService MieleAuth
@inject MieleState State
@inject MieleRecorder Recorder
@inject IKasaSettingsService KasaSettings
@inject ILiveStreamBroadcaster Live
@inject IPlugStateBroadcaster PlugStates
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>KasaMonitor — Aparate</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-water me-2"></i>Aparate Miele</h1>
    <div class="d-flex flex-wrap align-items-center gap-2 small text-secondary">
        <span class="badge @(State.StreamConnected ? "text-bg-success" : State.Mode == MieleStreamMode.Polling ? "text-bg-warning" : "text-bg-secondary")">
            @(State.StreamConnected ? "flux SSE conectat" : State.Mode == MieleStreamMode.Polling ? "citire la 60 s (SSE căzut)" : "neconectat")
        </span>
        @if (State.LastEventUtc is { } le)
        {
            <span title="@UiFormat.FullLocal(le)">ultimul eveniment: @State.LastEventName, @UiFormat.RelativeRo(le, DateTimeOffset.UtcNow)</span>
        }
    </div>
</div>

@if (_loadError is { } loadErr)
{
    <div class="alert alert-warning">Datele aparatelor nu au putut fi încărcate: @loadErr</div>
}

@if (_authMessage is { } am)
{
    <div class="alert @(am.Ok ? "alert-success" : "alert-warning")">@am.Text</div>
}

@if (_settings is null)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Se încarcă…</p>
}
else
{
    <div class="card mb-3">
        <div class="card-body small">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div>
                    <b>Cont Miele:</b>
                    @if (_settings.IsConnected) { <span class="badge text-bg-success">conectat</span> }
                    else { <span class="badge text-bg-secondary">deconectat</span> }
                </div>
                @if (State.ConnectedSinceUtc is { } since)
                {
                    <div class="text-secondary" title="@UiFormat.FullLocal(since)">flux deschis @UiFormat.RelativeRo(since, DateTimeOffset.UtcNow)</div>
                }
                @if (State.LastReadUtc is { } lr)
                {
                    <div class="text-secondary" title="@UiFormat.FullLocal(lr)">ultima citire a aparatelor: @UiFormat.RelativeRo(lr, DateTimeOffset.UtcNow)</div>
                }
                <div class="ms-auto">
                    @if (_settings.CanConnect)
                    {
                        <a class="btn btn-primary btn-sm" href="@MieleApi.ConnectPath"><i class="bi bi-box-arrow-in-right me-1"></i>@(_settings.Token is null ? "Conectează Miele" : "Reconectează")</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm" href="/settings"><i class="bi bi-gear me-1"></i>Setări → Miele</a>
                    }
                    @if (_settings.Token is not null)
                    {
                        <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="DisconnectAsync"><i class="bi bi-x-circle me-1"></i>Deconectează</button>
                    }
                </div>
            </div>
            @if ((_settings.AuthError ?? State.Status) is { } why)
            {
                <div class="mt-2 text-danger">@why</div>
            }
            @if (State.LastError is { } err && State.LastErrorUtc is { } errAt)
            {
                <div class="mt-1 text-warning-emphasis" title="@UiFormat.FullLocal(errAt)">Ultima eroare (@UiFormat.RelativeRo(errAt, DateTimeOffset.UtcNow)): @err</div>
            }
            @if (!_settings.CanConnect || _settings.Token is null)
            {
                <ol class="mt-2 mb-0">
                    <li>Pe <a href="https://developer.miele.com/get-involved" target="_blank" rel="noopener">developer.miele.com</a> obții Client ID și Client Secret (un set per e-mail).</li>
                    <li>Secretul se montează în container ca fișier (<code>@MieleApi.DefaultClientSecretFile</code>), Client ID-ul se pune în <a href="/settings">Setări → Miele</a>.</li>
                    <li>Deschide KasaMonitor la adresa folosită de obicei (redirect URI = <code>@CallbackExample</code>), apasă „Conectează Miele”, autentifică-te cu contul Miele
                        (țara: România) și bifează aparatele la consimțământ.</li>
                </ol>
            }
        </div>
    </div>

    @if (_appliances.Count == 0 && _settings.Token is not null)
    {
        <div class="alert alert-secondary">Niciun aparat încă. Aparatele apar după prima citire (aparatele trebuie bifate la consimțământul Miele).</div>
    }

    <div class="row g-3">
        @foreach (var a in _appliances)
        {
            var v = a.Values;
            var online = State.IsOnline(a, DateTimeOffset.UtcNow);
            var edit = Edit(a.Device);
            <div class="col-xl-6">
                <div class="card h-100 border-start border-4 @StatusBorder(v)">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
                            <div>
                                <h2 class="h5 mb-0">@a.Device.Alias</h2>
                                <div class="small text-secondary">@a.Device.TypeText@(a.Device.TechType.Length > 0 ? " · " + a.Device.TechType : "")</div>
                            </div>
                            <div class="text-end">
                                <span class="badge @StatusBadge(v) fs-6">@(v?.StatusText ?? "—")</span>
                                <div class="small mt-1"><span class="badge @(online ? "text-bg-success" : "text-bg-danger")">@(online ? "online" : "offline")</span></div>
                            </div>
                        </div>

                        <div class="row g-2 small mb-2">
                            <div class="col-sm-6"><span class="text-secondary">Program:</span> @(v?.ProgramIdText ?? "—")@(v?.ProgramTypeText is { } pt ? " (" + pt + ")" : "")</div>
                            <div class="col-sm-6">
                                <span class="text-secondary">Fază:</span> @(v?.PhaseText ?? "—")
                                @if (MieleTexts.ExpectedLoad(v?.PhaseText) is { } load) { <span class="text-secondary"> · @load</span> }
                            </div>
                            <div class="col-sm-6"><span class="text-secondary">Temperatură țintă:</span> @(v?.TargetTempC is { } tt ? tt.ToString("0") + " °C" : "—")</div>
                            <div class="col-sm-6"><span class="text-secondary">Turație:</span> @(v?.SpinRpm is { } rpm ? rpm + " rpm" : "—")</div>
                            <div class="col-sm-6"><span class="text-secondary">Ușă:</span> @(v?.DoorOpen is { } door ? (door ? "deschisă" : "închisă") : "—")</div>
                            <div class="col-sm-6">
                                <span class="text-secondary">Semnale:</span>
                                @(v?.SignalFailure == true ? "defecțiune" : v?.SignalInfo == true ? "informare" : "—")
                                @if (v?.RemoteMobileStart == true) { <span class="badge text-bg-light ms-1">MobileStart</span> }
                            </div>
                        </div>

                        @if (v?.RemainingSec is { } rem && (v.IsRunning || rem > 0))
                        {
                            var pct = Progress(v);
                            <div class="small mb-1">
                                Rămas: <b>@UiFormat.DurationRo(rem)</b>
                                @if (v.ElapsedSec is { } el) { <span class="text-secondary"> · trecut @UiFormat.DurationRo(el)</span> }
                                @if (rem > 0) { <span class="text-secondary"> · gata pe la @DateTime.Now.AddSeconds(rem).ToString("HH:mm")</span> }
                            </div>
                            <div class="progress mb-2" style="height: .6rem" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar @(v.IsRunning ? "progress-bar-striped progress-bar-animated" : "")" style="width: @(pct)%"></div>
                            </div>
                        }

                        <div class="small mb-2">
                            <span class="text-secondary">Consum program (aparat):</span>
                            @(v?.EcoEnergyKwh is { } ek ? ek.ToString("0.00") + " kWh" : "—"), @(v?.EcoWaterL is { } ew ? ew.ToString("0") + " l" : "—")
                            <span class="text-secondary"> · prognoză</span>
                            energie @(v?.EcoEnergyForecast is { } ef ? (ef * 100).ToString("0") + " %" : "—"), apă @(v?.EcoWaterForecast is { } wf ? (wf * 100).ToString("0") + " %" : "—")
                        </div>

                        @if (a.OpenCycle is { } oc && oc.Phases.Count > 0)
                        {
                            <div class="small text-secondary mb-1">Ciclul curent (din @oc.StartUtc.ToLocalTime().ToString("HH:mm")):</div>
                            @PhaseBand(oc, DateTimeOffset.UtcNow)
                        }

                        <div class="row g-2 align-items-end small mt-2">
                            <div class="col-sm-5">
                                <label class="form-label mb-0" for="alias-@a.Device.Id.GetHashCode()">Alias</label>
                                <input class="form-control form-control-sm" id="alias-@a.Device.Id.GetHashCode()" @bind="edit.Alias" />
                            </div>
                            <div class="col-sm-5">
                                <label class="form-label mb-0" for="plug-@a.Device.Id.GetHashCode()">Priza care îl alimentează</label>
                                <select class="form-select form-select-sm" id="plug-@a.Device.Id.GetHashCode()" @bind="edit.PlugId">
                                    <option value="">— niciuna —</option>
                                    @foreach (var p in _plugs)
                                    {
                                        <option value="@p.Id">@p.Alias</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-2">
                                <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => SaveDeviceAsync(a.Device.Id)">Salvează</button>
                            </div>
                        </div>
                        <div class="small mt-1 text-secondary">
                            @if (a.Device.PlugId is { } plug)
                            {
                                <span>Priza @PlugAlias(plug) acum: <b>@(PlugPowerW(plug) is { } w ? w.ToString("0") + " W" : "—")</b>. Evenimentele contorului confirmate de priză primesc numele fazei (adevăr de teren NILM).</span>
                            }
                            else
                            {
                                <span>Fără priză legată: energia măsurată pe ciclu și adevărul de teren NILM lipsesc.</span>
                            }
                        </div>
                        @if (_saveMessage.TryGetValue(a.Device.Id, out var msg)) { <div class="small text-success">@msg</div> }
                        <div class="small text-secondary mt-1">Cicluri încheiate: @a.CyclesTotal@(a.Device.LastSeenUtc is { } seen ? " · văzut " + UiFormat.RelativeRo(seen, DateTimeOffset.UtcNow) : "")</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card mt-3">
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <span class="fw-semibold"><i class="bi bi-clock-history me-2"></i>Istoric cicluri</span>
            @if (State.HistorySyncUtc is { } hs)
            {
                <span class="small text-secondary" title="@UiFormat.FullLocal(hs)">istoricul Miele citit @UiFormat.RelativeRo(hs, DateTimeOffset.UtcNow)</span>
            }
            <div class="ms-auto d-flex align-items-center gap-2">
                <label class="small text-secondary mb-0" for="history-device">Aparat</label>
                <select class="form-select form-select-sm w-auto" id="history-device" value="@_filter" @onchange="FilterChangedAsync">
                    <option value="">toate</option>
                    @foreach (var a in _appliances)
                    {
                        <option value="@a.Device.Id">@a.Device.Alias</option>
                    }
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            @if (State.HistoryMessage is { } hm)
            {
                <div class="small text-warning-emphasis px-3 pt-2">@hm</div>
            }
            @if (_page.Items.Count == 0)
            {
                <p class="text-secondary small p-3 mb-0">Niciun ciclu înregistrat încă.</p>
            }
            else
            {
                var showDevice = _filter.Length == 0 && _appliances.Count > 1;
                var columns = showDevice ? 13 : 12;
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 small">
                        <thead>
                            <tr>
                                <th></th><th>Început</th>
                                @if (showDevice) { <th>Aparat</th> }
                                <th>Durată</th><th>Program</th><th>Sursă</th><th style="min-width: 14rem">Faze</th>
                                <th class="text-end">Energie</th><th class="text-end">Priză</th><th class="text-end">Apă</th><th class="text-end">Cost</th><th>Sfârșit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _page.Items)
                            {
                                var cycle = c;
                                var expanded = _expanded.Contains(c.Id);
                                var (energy, energySource) = EnergyCell(c);
                                var (water, waterSource) = WaterCell(c);
                                <tr>
                                    <td>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-secondary" title="@(expanded ? "Ascunde detaliul" : "Detaliu: estimarea Miele față de priză")"
                                                aria-expanded="@(expanded ? "true" : "false")" @onclick="() => ToggleAsync(cycle)">
                                            <i class="bi @(expanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                        </button>
                                    </td>
                                    <td class="text-nowrap">@c.StartUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    @if (showDevice) { <td>@DeviceAlias(c.DeviceId)</td> }
                                    <td class="text-nowrap">@(c.EndUtc is { } end ? UiFormat.DurationRo((end - c.StartUtc).TotalSeconds) : "în curs")</td>
                                    <td>@(c.Program ?? "—")</td>
                                    <td><span class="badge rounded-pill border text-secondary fw-normal" title="@SourceTitle(c.Source)">@MieleCycleSources.Name(c.Source)</span></td>
                                    <td>
                                        @if (c.Phases.Count > 0) { @PhaseBand(c, DateTimeOffset.UtcNow) }
                                        else { <span class="text-secondary">—</span> }
                                    </td>
                                    <td class="text-end text-nowrap" title="sursa: @energySource">@energy</td>
                                    <td class="text-end text-nowrap" title="măsurat de priza legată pe durata ciclului">@(c.PlugEnergyWh is { } pw ? (pw / 1000).ToString("0.00") + " kWh" : "—")</td>
                                    <td class="text-end text-nowrap" title="sursa: @waterSource">@water</td>
                                    <td class="text-end text-nowrap" title="@(c.PlugEnergyWh is not null ? "după priză" : "după Miele")">@Cost(c)</td>
                                    <td class="text-secondary">@(c.IsOpen ? "—" : MieleEndReasons.Name(c.EndReason))</td>
                                </tr>
                                @if (expanded)
                                {
                                    <tr>
                                        <td colspan="@columns" class="bg-body-tertiary">@CycleDetailView(c)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="card-footer small text-secondary d-flex flex-wrap align-items-center gap-2">
            <span>Miele oferă ultimele 5 rulări; de la conectare încolo KasaMonitor păstrează tot.</span>
            @if (_page.Total > PageSize)
            {
                <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="Pagini">
                    <button type="button" class="btn btn-outline-secondary" disabled="@(_pageIndex == 0)" @onclick="() => GoToPageAsync(_pageIndex - 1)">◀</button>
                    <span class="btn btn-outline-secondary disabled">pagina @(_pageIndex + 1) din @PageCount · @_page.Total cicluri</span>
                    <button type="button" class="btn btn-outline-secondary" disabled="@(_pageIndex >= PageCount - 1)" @onclick="() => GoToPageAsync(_pageIndex + 1)">▶</button>
                </div>
            }
        </div>
    </div>
    <p class="small text-secondary mt-3">
        Fazele și numele lor vin dintr-o listă a comunității (Home Assistant), nu din documentația Miele; o fază necunoscută apare cu numele dat de API
        (în engleză) sau ca „faza &lt;cod&gt;”. „Energie” = valoarea din istoricul API Miele când rularea apare acolo, altfel energia măsurată de priză,
        altfel ecoFeedback din timpul ciclului; „Apă” = istoricul API, altfel ecoFeedback (tooltip-ul spune sursa). Detaliul unui ciclu arată toate trei
        separat: istoricul API, ecoFeedback și priza. Costul folosește energia prizei când există și tariful din Setări. Sursa: „observat” = văzut de KasaMonitor, „din API” = doar în istoricul Miele (fără faze), „ambele” = văzut și
        găsit în istoric.
    </p>
}

@code {
    private sealed class DeviceEdit
    {
        public string Alias { get; set; } = "";
        public string PlugId { get; set; } = "";
    }

    [SupplyParameterFromQuery(Name = "auth")] public string? Auth { get; set; }

    private MieleRuntimeSettings? _settings;
    private IReadOnlyList<MieleApplianceLive> _appliances = Array.Empty<MieleApplianceLive>();
    private const int PageSize = 50;
    private MieleCyclePage _page = new(Array.Empty<MieleCycle>(), 0);
    private string _filter = "";
    private int _pageIndex;
    private readonly HashSet<long> _expanded = new();
    private readonly Dictionary<long, CycleDetail> _details = new();
    private IReadOnlyList<Plug> _plugs = Array.Empty<Plug>();
    private readonly Dictionary<string, DeviceEdit> _edits = new();
    private readonly Dictionary<string, string> _saveMessage = new();
    private (bool Ok, string Text)? _authMessage;
    private decimal _tariff;
    private string? _loadError;
    private System.Threading.Timer? _timer;

    private string CallbackExample => Nav.BaseUri.TrimEnd('/') + MieleApi.CallbackPath;

    protected override async Task OnInitializedAsync()
    {
        _authMessage = Auth switch
        {
            "connected" => (true, "Contul Miele e conectat. Prima citire pornește acum."),
            "denied" => (false, "Autorizarea a fost refuzată sau anulată în pagina Miele."),
            "exchangefailed" => (false, "Codul de autorizare nu a putut fi schimbat pe token (vezi logul; reia conectarea)."),
            "notconfigured" => (false, "Setează întâi Client ID-ul Miele și montează secretul clientului (Setări → Miele)."),
            _ => null,
        };
        await LoadAsync();
        State.Changed += OnStateChanged;
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 30_000, 30_000);
    }

    private void OnStateChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    private async Task LoadAsync()
    {
        try
        {
            _settings = await MieleSettings.GetAsync(CancellationToken.None);
            _appliances = State.Appliances;
            using var scope = ScopeFactory.CreateScope();
            var repo = scope.ServiceProvider.GetRequiredService<IMieleRepository>();
            if (_filter.Length > 0 && _appliances.All(a => a.Device.Id != _filter)) _filter = "";
            var ids = _filter.Length > 0 ? new[] { _filter } : _appliances.Select(a => a.Device.Id).ToArray();
            _page = await repo.ListCyclesPageAsync(ids, _pageIndex * PageSize, PageSize, CancellationToken.None);
            if (_pageIndex > 0 && _page.Items.Count == 0 && _page.Total > 0)
            {
                _pageIndex = PageCount - 1;
                _page = await repo.ListCyclesPageAsync(ids, _pageIndex * PageSize, PageSize, CancellationToken.None);
            }
            if (_plugs.Count == 0)
                _plugs = (await scope.ServiceProvider.GetRequiredService<IPlugRepository>().ListAllAsync(CancellationToken.None))
                    .Where(p => !p.IsArchived && p.Role != PlugRole.MainMeter).OrderBy(p => p.Alias, StringComparer.CurrentCultureIgnoreCase).ToList();
            _tariff = (await KasaSettings.GetAsync(CancellationToken.None)).TariffRonPerKwh;
            _loadError = null;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private DeviceEdit Edit(MieleDevice d)
    {
        if (!_edits.TryGetValue(d.Id, out var e))
            _edits[d.Id] = e = new DeviceEdit { Alias = d.Alias, PlugId = d.PlugId?.ToString() ?? "" };
        return e;
    }

    private async Task SaveDeviceAsync(string deviceId)
    {
        if (!_edits.TryGetValue(deviceId, out var e)) return;
        try
        {
            using (var scope = ScopeFactory.CreateScope())
            {
                var repo = scope.ServiceProvider.GetRequiredService<IMieleRepository>();
                var alias = e.Alias.Trim();
                if (alias.Length > 0) await repo.SetAliasAsync(deviceId, alias.Length > 64 ? alias[..64] : alias, CancellationToken.None);
                await repo.SetPlugAsync(deviceId, Guid.TryParse(e.PlugId, out var plug) ? plug : null, CancellationToken.None);
            }
            await Recorder.ReloadDeviceAsync(deviceId, CancellationToken.None);
            _edits.Remove(deviceId);
            _saveMessage[deviceId] = "Salvat.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _saveMessage[deviceId] = "Eroare: " + ex.Message;
        }
    }

    private async Task DisconnectAsync()
    {
        await MieleAuth.LogoutAsync(CancellationToken.None);
        await LoadAsync();
    }

    private int PageCount => Math.Max(1, (_page.Total + PageSize - 1) / PageSize);

    private async Task FilterChangedAsync(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() ?? "";
        _pageIndex = 0;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int index)
    {
        _pageIndex = Math.Clamp(index, 0, PageCount - 1);
        await LoadAsync();
    }

    private string DeviceAlias(string deviceId) => _appliances.FirstOrDefault(a => a.Device.Id == deviceId)?.Device.Alias ?? deviceId;

    private static string SourceTitle(string source) => source switch
    {
        MieleCycleSources.Api => "Doar din istoricul Miele (lastUsedPrograms): rulare pe care KasaMonitor n-a văzut-o, fără faze.",
        MieleCycleSources.Merged => "Văzut de KasaMonitor și găsit în istoricul Miele: în tabel energia și apa vin din istoric.",
        _ => "Văzut de KasaMonitor (flux SSE); încă negăsit în istoricul Miele.",
    };

    private const string ApiSource = "istoricul API Miele, lastUsedPrograms (calculat de Miele)";
    private const string EcoSource = "aparatul, ecoFeedback văzut în timpul ciclului (calculat de Miele)";
    private const string PlugSource = "priza legată (măsurat)";

    /// <summary>Energy in the table: the API history's, else the plug's, else ecoFeedback; with its source for the tooltip.</summary>
    private static (string Text, string Source) EnergyCell(MieleCycle c)
    {
        if (c.ApiEnergyKwh is { } api) return (Kwh(api), ApiSource);
        if (c.PlugEnergyWh is { } wh) return (Kwh(wh / 1000), PlugSource);
        if (c.EnergyKwh is { } eco) return (Kwh(eco), EcoSource);
        return ("—", "nicio valoare");
    }

    /// <summary>Water in the table: the API history's, else ecoFeedback (a plug measures no water).</summary>
    private static (string Text, string Source) WaterCell(MieleCycle c)
    {
        if (c.ApiWaterL is { } api) return (Litres(api), ApiSource);
        if (c.WaterL is { } eco) return (Litres(eco), EcoSource);
        return ("—", "nicio valoare");
    }

    private static string Kwh(double? kwh) => kwh is { } k ? k.ToString("0.00") + " kWh" : "—";
    private static string Litres(double? l) => l is { } v ? v.ToString("0.#") + " l" : "—";

    public sealed record PowerPoint(long Ms, decimal? W);

    /// <summary>The detail of a cycle: Miele's 15-min estimate vs the plug's power on the same interval.</summary>
    private sealed record CycleDetail(
        IReadOnlyList<PowerPoint> Plug,
        IReadOnlyList<PowerPoint> Miele,
        IReadOnlyList<MieleEnergyComparison.SlotCompare> Slots,
        ApexChartOptions<PowerPoint> Options,
        string? PlugAlias,
        string? Error);

    private async Task ToggleAsync(MieleCycle c)
    {
        if (_expanded.Remove(c.Id)) return;
        _expanded.Add(c.Id);
        // Reloaded at every opening: a later history read may have added Miele's profile.
        _details[c.Id] = await LoadDetailAsync(c);
    }

    private async Task<CycleDetail> LoadDetailAsync(MieleCycle c)
    {
        var profile = c.EnergyProfile ?? Array.Empty<MieleEnergySlot>();
        var from = c.StartUtc;
        var to = c.EndUtc ?? DateTimeOffset.UtcNow;
        if (profile.Count > 0)
        {
            if (profile[0].StartUtc < from) from = profile[0].StartUtc;
            var last = profile[^1].StartUtc + MieleEnergyComparison.Slot;
            if (last > to) to = last;
        }
        var device = _appliances.FirstOrDefault(a => a.Device.Id == c.DeviceId)?.Device;
        IReadOnlyList<LiveMinuteAggregate> minutes = Array.Empty<LiveMinuteAggregate>();
        IReadOnlyList<Sample> samples = Array.Empty<Sample>();
        string? error = null;
        try
        {
            if (device?.PlugId is { } plug)
            {
                using var scope = ScopeFactory.CreateScope();
                minutes = await scope.ServiceProvider.GetRequiredService<ILiveRepository>().ListMinutesAsync(plug, from.AddMinutes(-1), to, CancellationToken.None);
                if (minutes.Count == 0)
                    samples = await scope.ServiceProvider.GetRequiredService<ISampleRepository>().ListByPlugAsync(plug, from - MielePlugEnergy.MaxHold, to, CancellationToken.None);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        var plugPoints = MieleEnergyComparison.PlugPower(minutes, samples, from, to)
            .Select(p => new PowerPoint(p.TsUtc.ToUnixTimeMilliseconds(), (decimal)Math.Round(p.W, 0))).ToList();
        var mielePoints = MieleEnergyComparison.ProfilePower(profile)
            .Select(p => new PowerPoint(p.TsUtc.ToUnixTimeMilliseconds(), (decimal)Math.Round(p.W, 0))).ToList();
        var options = new ApexChartOptions<PowerPoint>
        {
            Chart = new Chart { Toolbar = new Toolbar { Show = false }, Animations = new Animations { Enabled = false }, Zoom = new Zoom { Enabled = false } },
            Stroke = new Stroke { Width = 2, Curve = Curve.Stepline },
            DataLabels = new DataLabels { Enabled = false },
            Xaxis = new XAxis { Min = from.ToUnixTimeMilliseconds(), Max = to.ToUnixTimeMilliseconds(), Labels = new XAxisLabels { DatetimeUTC = false } },
            Yaxis = new List<YAxis> { new() { Min = 0, DecimalsInFloat = 0, Title = new AxisTitle { Text = "W" } } },
            Tooltip = new Tooltip { Shared = true, X = new TooltipX { Format = "dd.MM HH:mm" } },
        };
        return new CycleDetail(plugPoints, mielePoints, MieleEnergyComparison.Slots(profile, minutes, samples), options,
            device?.PlugId is { } p ? PlugAlias(p) : null, error);
    }

    private RenderFragment CycleDetailView(MieleCycle c) => __builder =>
    {
        _details.TryGetValue(c.Id, out var d);
        <div class="py-1">
            <div class="d-flex flex-wrap gap-3 mb-1">
                <span><span class="text-secondary">Sursa:</span> @SourceTitle(c.Source)</span>
                @if (c.ApiStartUtc is { } aStart)
                {
                    <span><span class="text-secondary">În istoricul Miele:</span> @aStart.ToLocalTime().ToString("yyyy-MM-dd HH:mm")–@(c.ApiEndUtc?.ToLocalTime().ToString("HH:mm") ?? "?")</span>
                }
            </div>
            <table class="table table-sm table-borderless w-auto mb-1">
                <thead><tr><th class="fw-normal text-secondary">Sursa</th><th class="fw-normal text-secondary text-end">Energie</th><th class="fw-normal text-secondary text-end">Apă</th></tr></thead>
                <tbody>
                    <tr><td>Istoric API Miele (lastUsedPrograms, calculat)</td><td class="text-end">@Kwh(c.ApiEnergyKwh)</td><td class="text-end">@Litres(c.ApiWaterL)</td></tr>
                    <tr><td>ecoFeedback în timpul ciclului (calculat de Miele)</td><td class="text-end">@Kwh(c.EnergyKwh)</td><td class="text-end">@Litres(c.WaterL)</td></tr>
                    <tr><td>Priza legată (măsurat)</td><td class="text-end">@Kwh(c.PlugEnergyWh / 1000)</td><td class="text-end">—</td></tr>
                </tbody>
            </table>
            <div class="d-flex flex-wrap gap-3 mb-1">
                @if (d is not null && d.Slots.Count > 0)
                {
                    var mieleWh = d.Slots.Sum(x => x.MieleWh);
                    double? plugWh = d.Slots.All(x => x.PlugWh is null) ? null : d.Slots.Sum(x => x.PlugWh ?? 0);
                    <span><span class="text-secondary">Pe intervalele de 15 min:</span> Miele estimează @((mieleWh / 1000).ToString("0.00")) kWh, priza a măsurat @(plugWh is { } pwh ? (pwh / 1000).ToString("0.00") + " kWh" : "—")</span>
                }
            </div>
            @if (d is null)
            {
                <span class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Se încarcă…</span>
            }
            else
            {
                @if (d.Error is { } err)
                {
                    <div class="text-warning-emphasis">Datele prizei nu au putut fi citite: @err</div>
                }
                @if (d.Miele.Count == 0)
                {
                    <div class="text-secondary">Miele n-a trimis profilul de energie pe 15 minute pentru această rulare.</div>
                }
                @if (d.PlugAlias is null)
                {
                    <div class="text-secondary">Fără priză legată: nu există măsurătoare de comparat.</div>
                }
                else if (d.Plug.Count == 0)
                {
                    <div class="text-secondary">Priza @d.PlugAlias nu are citiri în acest interval.</div>
                }
                @if (d.Miele.Count > 0 || d.Plug.Count > 0)
                {
                    <div style="max-width: 44rem">
                        <ApexChart @key="c.Id" TItem="PowerPoint" Options="d.Options" Height="180" XAxisType="XAxisType.Datetime">
                            @if (d.Plug.Count > 0)
                            {
                                <ApexPointSeries TItem="PowerPoint" Items="d.Plug" Name="@("Priza " + d.PlugAlias + " (W, măsurat)")" Color="#0072B2" SeriesType="SeriesType.Line" XValue="@(p => p.Ms)" YValue="@(p => p.W)" />
                            }
                            @if (d.Miele.Count > 0)
                            {
                                <ApexPointSeries TItem="PowerPoint" Items="d.Miele" Name="Miele (W medii pe 15 min, estimat)" Color="#D55E00" SeriesType="SeriesType.Line" XValue="@(p => p.Ms)" YValue="@(p => p.W)" />
                            }
                        </ApexChart>
                    </div>
                }
            }
        </div>
    };

    private string PlugAlias(Guid id) => _plugs.FirstOrDefault(p => p.Id == id)?.Alias ?? "(arhivată)";

    private double? PlugPowerW(Guid id) =>
        Live.Latest(id) is { } s && DateTimeOffset.UtcNow - s.TsUtc < TimeSpan.FromMinutes(2) ? s.PowerW
        : PlugStates.Snapshot().TryGetValue(id, out var st) && st.LastReading is { } r ? r.PowerMw / 1000.0 : null;

    private string Cost(MieleCycle c)
    {
        var kwh = c.PlugEnergyWh is { } wh ? wh / 1000 : c.MieleEnergyKwh;
        return kwh is { } k ? EnergyFormat.Lei((decimal)k * _tariff) : "—";
    }

    private static int Progress(MieleStateValues v)
    {
        var total = (v.ElapsedSec ?? 0) + (v.RemainingSec ?? 0);
        return total <= 0 ? 0 : (int)Math.Round(100.0 * (v.ElapsedSec ?? 0) / total);
    }

    private static string StatusBadge(MieleStateValues? v) => v?.StatusRaw switch
    {
        5 => "text-bg-primary",
        6 or 3 or 4 => "text-bg-info",
        7 => "text-bg-success",
        8 or 9 => "text-bg-danger",
        255 => "text-bg-dark",
        _ => "text-bg-secondary",
    };

    private static string StatusBorder(MieleStateValues? v) => v?.StatusRaw switch
    {
        5 => "border-primary",
        7 => "border-success",
        8 or 9 => "border-danger",
        _ => "border-secondary",
    };

    /// <summary>Colour of a phase in the band (heating red, rinse blue, spin purple, drain teal, idle grey, others by hash).</summary>
    private static string PhaseColor(string text) => text switch
    {
        "Prespălare" or "Spălare principală" or "Igienizare" or "Dezinfectare" or "Înmuiere" => "#dc3545",
        "Clătire" or "Clătiri" or "Oprire la clătire" => "#0d6efd",
        "Centrifugare" or "Termo-centrifugare" => "#6f42c1",
        "Evacuare" => "#20c997",
        "Uscare" or "Uscat normal" or "Uscat extra" or "Uscat normal plus" or "Uscare igienică" => "#fd7e14",
        "Răcire" or "Răcire confort" or "Răcire de siguranță" => "#0dcaf0",
        "Anti-șifonare" or "Terminat" or "nu rulează" => "#adb5bd",
        _ => Palette[(int)((uint)StringComparer.Ordinal.GetHashCode(text) % (uint)Palette.Length)],
    };

    private static readonly string[] Palette = { "#198754", "#ffc107", "#d63384", "#6610f2", "#795548", "#607d8b" };

    private static RenderFragment PhaseBand(MieleCycle c, DateTimeOffset now) => builder =>
    {
        var end = c.EndUtc ?? now;
        var total = Math.Max(1, (end - c.StartUtc).TotalSeconds);
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "d-flex rounded overflow-hidden");
        builder.AddAttribute(seq++, "style", "height: .9rem; min-width: 10rem");
        foreach (var p in c.Phases)
        {
            var to = p.ToUtc ?? end;
            var share = Math.Max(0.5, 100.0 * (to - p.FromUtc).TotalSeconds / total);
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style", $"width: {share.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%; background: {PhaseColor(p.PhaseText)}");
            builder.AddAttribute(seq++, "title", $"{p.PhaseText}: {p.FromUtc.ToLocalTime():HH:mm}–{to.ToLocalTime():HH:mm} ({UiFormat.DurationRo((to - p.FromUtc).TotalSeconds)})"
                + (MieleTexts.ExpectedLoad(p.PhaseText) is { } load ? " · " + load : ""));
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        _timer?.Dispose();
    }
}
