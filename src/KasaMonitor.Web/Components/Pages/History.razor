@page "/history"
@rendermode InteractiveServer
@using KasaMonitor.Core.History
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav
@inject KasaMonitor.Workers.IKasaSettingsService KasaSettings

<PageTitle>KasaMonitor — History</PageTitle>
<h1 class="h3 mb-3"><i class="bi bi-bar-chart me-2"></i>History</h1>

@if (_plugs is null || _plugs.Count == 0)
{
    <div class="alert alert-secondary">No plugs available.</div>
}
else
{
    <div class="d-flex flex-wrap gap-3 mb-3">
        <label class="d-flex align-items-center gap-2">Plug
            <select class="form-select form-select-sm w-auto" value="@(_allSelected ? AllValue : _selectedPlugId.ToString())" @onchange="OnPlugChanged">
                <option value="@AllValue">Toate</option>
                @foreach (var p in _plugs.OrderBy(p => p.Alias))
                {
                    <option value="@p.Id">@p.Alias</option>
                }
            </select>
        </label>
        <label class="d-flex align-items-center gap-2">Range
            <select class="form-select form-select-sm w-auto" value="@_rangeDays" @onchange="OnRangeChanged">
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="365">Last 12 months</option>
            </select>
        </label>
    </div>

    @if (_allSelected)
    {
        @if (_all is null)
        {
            <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading data…</p>
        }
        else if (_all.Days.Count == 0)
        {
            <div class="alert alert-secondary">No daily history yet — it is read from the plugs every 6 h and right after a plug is added.</div>
        }
        else
        {
            <div class="card mb-3"><div class="card-body">
            <h2 class="h6 text-secondary" title="Barele: prizele (rol „priză”), stivuite. Linia „Casă”: contorul general, separat (conține deja prizele, nu se adună la ele). Sub-contoarele nu apar aici.">Energie pe zi, toate prizele (kWh) și casa</h2>
            <ApexChart @key="_chartKey" TItem="DayPoint" Title="kWh / day" Options="_allChartOptions">
                @foreach (var s in _all.Series)
                {
                    <ApexPointSeries TItem="DayPoint"
                                     Items="@Points(s)"
                                     Name="@s.Alias"
                                     Color="@s.Color"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(d => d.Date)"
                                     YValue="@(d => d.Kwh)" />
                }
                @if (_all.House is { } house)
                {
                    <ApexPointSeries TItem="DayPoint"
                                     Items="@Points(house)"
                                     Name="@house.Alias"
                                     Color="@house.Color"
                                     SeriesType="SeriesType.Line"
                                     XValue="@(d => d.Date)"
                                     YValue="@(d => d.Kwh)" />
                }
            </ApexChart>
            </div></div>

            <div class="card" style="max-width: 32rem;">
            <table class="table table-sm mb-0 totals-table">
                <thead class="table-light"><tr><th>Plug</th><th>kWh</th><th>Cost (RON)</th></tr></thead>
                <tbody>
                    @foreach (var s in _all.Series)
                    {
                        <tr>
                            <td><span class="swatch" style="background:@s.Color"></span>@s.Alias</td>
                            <td>@((s.TotalWh / 1000.0).ToString("0.000"))</td>
                            <td>@Tariff.CostFromWh(s.TotalWh).ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>Total prize</th>
                        <th>@((_all.TotalWh / 1000.0).ToString("0.000"))</th>
                        <th>@Tariff.CostFromWh(_all.TotalWh).ToString("0.00")</th>
                    </tr>
                    @if (_all.House is { } h)
                    {
                        <tr title="Contorul general: conține deja prizele, nu se adună la total">
                            <td><span class="swatch" style="background:@h.Color"></span>Casă (contor general)</td>
                            <td>@((h.TotalWh / 1000.0).ToString("0.000"))</td>
                            <td>@Tariff.CostFromWh(h.TotalWh).ToString("0.00")</td>
                        </tr>
                    }
                </tfoot>
            </table>
            </div>
            <p class="form-text">@_all.Days.First().ToString("yyyy-MM-dd") – @_all.Days.Last().ToString("yyyy-MM-dd"), tariff @Tariff.RonPerKwh.ToString("0.00") RON/kWh. Withdrawn and unsupported plugs are not included.</p>
        }
    }
    else if (_dailyData is null)
    {
        <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading data…</p>
    }
    else if (_dailyData.Count == 0)
    {
        <div class="alert alert-secondary">No daily history yet for this plug — it is read every 6 h and right after a plug is added.</div>
    }
    else
    {
        <div class="card"><div class="card-body">
        <h2 class="h6 text-secondary">Energy per day (kWh)</h2>
        <ApexChart @key="_chartKey" TItem="DailyKwhPoint" Title="kWh / day"
                   Options="_chartOptions">
            <ApexPointSeries TItem="DailyKwhPoint"
                             Items="_dailyData"
                             Name="kWh"
                             SeriesType="SeriesType.Bar"
                             XValue="@(d => d.Date)"
                             YValue="@(d => (decimal)(d.EnergyWh / 1000.0))" />
        </ApexChart>
        </div></div>
    }
}

<style>
    .totals-table td:nth-child(n+2), .totals-table th:nth-child(n+2) { text-align: right; }
    .totals-table .swatch { display: inline-block; width: 0.9em; height: 0.9em; margin-right: 0.5em; vertical-align: -0.1em; border-radius: 2px; }
</style>

@code {
    private const string AllValue = "all";

    [SupplyParameterFromQuery(Name = "plugId")] public Guid? QueryPlugId { get; set; }

    private List<Plug>? _plugs;
    private Guid _selectedPlugId;
    private bool _allSelected = true;
    private int _rangeDays = 30;
    private List<DailyKwhPoint>? _dailyData;
    private AllPlugsDailyEnergy? _all;
    private int _chartKey;
    private ApexChartOptions<DailyKwhPoint> _chartOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } }
    };
    private ApexChartOptions<DayPoint> _allChartOptions = new();

    public record DailyKwhPoint(string Date, long EnergyWh);
    public record DayPoint(string Date, decimal Kwh);

    private IEnumerable<DayPoint> Points(PlugDailySeries s) =>
        _all!.Days.Select((d, i) => new DayPoint(d.ToString("yyyy-MM-dd"), s.DailyWh[i] / 1000m)).ToList();

    private KasaMonitor.Core.Costing.TariffCalculator Tariff = null!;

    protected override async Task OnInitializedAsync()
    {
        // Same tariff as the Dashboard: the value saved in /settings, falling back to the startup value.
        Tariff = new KasaMonitor.Core.Costing.TariffCalculator((await KasaSettings.GetAsync(CancellationToken.None)).TariffRonPerKwh);
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<IPlugRepository>();
        _plugs = (await repo.ListAllAsync(CancellationToken.None)).Where(p => !p.IsArchived).ToList();
        if (_plugs.Count > 0)
        {
            if (QueryPlugId is { } qp && _plugs.Any(p => p.Id == qp))
            {
                _allSelected = false;
                _selectedPlugId = qp;
            }
            await ReloadDataAsync();
        }
    }

    private async Task OnPlugChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (value == AllValue)
        {
            _allSelected = true;
            await ReloadDataAsync();
        }
        else if (Guid.TryParse(value, out var id))
        {
            _allSelected = false;
            _selectedPlugId = id;
            await ReloadDataAsync();
        }
    }

    private async Task OnRangeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var days))
        {
            _rangeDays = days;
            await ReloadDataAsync();
        }
    }

    private async Task ReloadDataAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var historyRepo = scope.ServiceProvider.GetRequiredService<IHistoryRepository>();
        var to = DateOnly.FromDateTime(DateTime.UtcNow);
        var from = to.AddDays(-_rangeDays);

        if (_allSelected)
        {
            var rows = await historyRepo.GetDailyRangeAllAsync(from, to, CancellationToken.None);
            _all = AllPlugsDailyEnergy.Build(_plugs!, rows);
            _allChartOptions = BuildAllChartOptions(_all);
        }
        else
        {
            if (_selectedPlugId == Guid.Empty) return;
            var entries = await historyRepo.GetDailyRangeAsync(_selectedPlugId, from, to, CancellationToken.None);
            _dailyData = entries.Select(d => new DailyKwhPoint(
                $"{d.Year:D4}-{d.Month:D2}-{d.Day:D2}", d.EnergyWh)).ToList();
        }
        _chartKey++;
        StateHasChanged();
    }

    private static ApexChartOptions<DayPoint> BuildAllChartOptions(AllPlugsDailyEnergy all)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var totals = string.Join(",", all.DayTotalsWh.Select(wh => (wh / 1000.0).ToString("0.000", inv)));
        return new ApexChartOptions<DayPoint>
        {
            // Only the plug bars are stacked; the "Casă" line (main meter) stays on its own.
            Chart = new Chart { Stacked = true, StackOnlyBar = true, Toolbar = new Toolbar { Show = false } },
            PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = false } },
            Legend = new Legend { Show = true, OnItemClick = new LegendOnItemClick { ToggleDataSeries = true } },
            Tooltip = new Tooltip
            {
                Shared = true,
                Intersect = false,
                X = new TooltipX
                {
                    // Day total (all plugs) in the tooltip header; the per-plug values are listed below it.
                    Formatter = $"function(value, opts) {{ var t = [{totals}]; var i = opts ? opts.dataPointIndex : -1; return (i >= 0 && i < t.length) ? value + ' — total prize ' + t[i].toFixed(3) + ' kWh' : value; }}"
                },
                Y = new TooltipY { Formatter = "function(value) { return value == null ? '' : value.toFixed(3) + ' kWh'; }" }
            },
            DataLabels = new DataLabels { Enabled = false },
        };
    }
}
