@page "/plugs"
@rendermode InteractiveServer
@using KasaMonitor.Workers
@using KasaMonitor.Core.Protocol.Tapo
@using KasaMonitor.Web.Ui
@inject IServiceScopeFactory ScopeFactory
@inject PlugDiscoveryService Discovery
@implements IDisposable

<PageTitle>KasaMonitor — Prize</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-outlet me-2"></i>Prize</h1>
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-success btn-sm" @onclick="ScanNowAsync" disabled="@_scanning" title="Caută prize în rețea acum (UDP 9999 și 20002, mDNS Shelly)">
            @if (_scanning) { <span class="spinner-border spinner-border-sm me-1"></span><span>Se scanează…</span> }
            else { <i class="bi bi-search me-1"></i><span>Scanează acum</span> }
        </button>
        <div class="input-group input-group-sm" style="width: 22rem;">
            <span class="input-group-text"><i class="bi bi-plus-lg"></i></span>
            <input class="form-control" @bind="_manualIp" placeholder="IP, ex. 192.168.1.50" />
            <button class="btn btn-outline-primary" @onclick="AddByIpAsync" disabled="@_adding" title="Încearcă legacy (TCP 9999), apoi Tapo (UDP 20002 / KLAP / AES), apoi Shelly (HTTP /rpc)">
                @(_adding ? "Se încearcă…" : "Adaugă după IP")
            </button>
        </div>
    </div>
</div>

@if (_message is not null)
{
    <div class="alert alert-info py-2 d-flex align-items-center gap-2"><i class="bi bi-info-circle"></i>@_message</div>
}

@if (Discovery.LastScan is { } scan)
{
    <div class="card mb-4">
        <div class="card-header d-flex flex-wrap gap-3 align-items-center small">
            <span class="fw-semibold"><i class="bi bi-broadcast me-1"></i>Ultima scanare</span>
            <span title="@UiFormat.FullLocal(scan.AtUtc)">@UiFormat.RelativeRo(scan.AtUtc, DateTimeOffset.UtcNow)</span>
            <span class="badge text-bg-light border">@scan.Items.Count găsite</span>
            <span class="badge text-bg-success">@scan.NewCount noi</span>
            <span class="badge text-bg-warning">@scan.UnsupportedCount nesuportate</span>
            <span class="text-secondary">adăugare automată @(scan.AutoAdd ? "pornită" : "oprită")</span>
        </div>
        @if (scan.Items.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Stare</th><th>Alias</th><th>Model</th><th>MAC</th><th>IP</th><th class="text-end"></th></tr></thead>
                    <tbody>
                        @foreach (var i in scan.Items.OrderBy(i => i.Status).ThenBy(i => i.Plug.Info.Alias))
                        {
                            <tr>
                                <td>
                                    <span class="badge @ScanBadge(i) text-wrap text-start">@StatusText(i)</span>
                                    @if (!i.Plug.IsSupported && TapoSupport.IsUnknownProtocolReason(i.Plug.UnsupportedReason))
                                    {
                                        <div class="form-text text-warning-emphasis">@TapoSupport.ThirdPartyCompatibilityHint</div>
                                    }
                                </td>
                                <td>@i.Plug.Info.Alias</td>
                                <td><span class="badge text-bg-light border" title="@UiFormat.ModelTitle(i.Plug.Info.Model, i.Plug.Info.HwVer, i.Plug.Protocol)">@PlugModelName.Short(i.Plug.Info.Model)</span> <span class="badge @UiFormat.ProtocolBadge(i.Plug.Protocol)">@i.Plug.Protocol</span></td>
                                <td>
                                    <code class="text-secondary small">@i.Plug.Info.Mac</code>
                                    @if (i.Plug.Protocol == PlugProtocols.ShellyRpc && i.Plug.IsSupported) { <span class="badge text-bg-light border ms-1" title="Canal măsurat">ch@(i.Plug.Channel)</span> }
                                </td>
                                <td>@i.Plug.IpAddress</td>
                                <td class="text-end">
                                    @if (i.PlugId is null)
                                    {
                                        <button class="btn btn-outline-success btn-sm" @onclick="() => AddDiscoveredAsync(i)" title="Adaugă în listă"><i class="bi bi-plus-lg"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<div class="form-check form-switch mb-2">
    <input class="form-check-input" type="checkbox" id="showArchived" @bind="_showArchived" />
    <label class="form-check-label" for="showArchived">Arată retrase</label>
</div>

@if (_plugs is null)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Se încarcă…</p>
}
else if (_plugs.Count == 0)
{
    <div class="alert alert-secondary">Nicio priză în baza de date. Apasă „Scanează acum” sau adaugă una după IP.</div>
}
else
{
    var now = DateTimeOffset.UtcNow;
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Alias</th><th>Model</th><th title="Priză / contor general (casa) / sub-contor">Rol</th><th>IP / MAC</th><th>Firmware</th><th>Văzută</th><th>Stare</th><th class="text-end">Acțiuni</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in _plugs.Where(p => _showArchived || !p.IsArchived).OrderBy(p => p.Alias))
                    {
                        <tr class="@(p.IsArchived ? "opacity-50" : "")">
                            <td style="min-width: 14rem;">
                                @if (_editingId == p.Id)
                                {
                                    <div class="input-group input-group-sm">
                                        <input class="form-control" @bind="_editAlias" @bind:event="oninput" />
                                        <button class="btn btn-success" @onclick="() => SaveAlias(p.Id)" title="Salvează"><i class="bi bi-check-lg"></i></button>
                                        <button class="btn btn-outline-secondary" @onclick="CancelEdit" title="Renunță"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                }
                                else
                                {
                                    <span class="fw-semibold">@p.Alias</span>
                                    @if (p.AliasIsCustom) { <span class="badge text-bg-light border ms-1" title="Alias setat manual: nu se mai preia de pe priză">personalizat</span> }
                                    <button class="btn btn-link btn-sm p-0 ms-2 align-baseline text-secondary" @onclick="() => StartEdit(p)" title="Redenumește"><i class="bi bi-pencil"></i></button>
                                }
                            </td>
                            <td>
                                <span class="badge text-bg-light border" title="@UiFormat.ModelTitle(p.Model, p.HwVer, p.Protocol)">@PlugModelName.Short(p.Model)</span>
                                <span class="badge @UiFormat.ProtocolBadge(p.Protocol)">@p.Protocol</span>
                            </td>
                            <td class="text-nowrap">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Rol">
                                    @foreach (var role in PlugRoles.All)
                                    {
                                        <button class="btn @(p.Role == role ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetRoleAsync(p, role)" disabled="@p.IsArchived"
                                                title="@PlugRoles.Name(role): @PlugRoles.Description(role)" aria-pressed="@(p.Role == role)"><i class="bi @PlugRoles.Icon(role)"></i></button>
                                    }
                                </div>
                                <span class="badge @(p.Role == PlugRole.Plug ? "text-bg-light border" : "text-bg-info") ms-1" title="@PlugRoles.Description(p.Role)">@PlugRoles.Name(p.Role)</span>
                                @if (p.IsSupported && !p.IsArchived)
                                {
                                    <div class="form-check form-check-inline small mt-1 me-0" title="Flux live: contorul general la 1 s, prizele 1–10 s (adaptiv); un rând brut doar la schimbare sau o dată pe minut">
                                        <input class="form-check-input" type="checkbox" id="stream-@p.Id" checked="@p.StreamEnabled" @onchange="e => SetStreamAsync(p, e.Value is true)" />
                                        <label class="form-check-label" for="stream-@p.Id">flux 1 s</label>
                                    </div>
                                }
                                @if (p.Role != PlugRole.MainMeter && p.Protocol == PlugProtocols.ShellyRpc && !p.IsArchived)
                                {
                                    <div><button class="btn btn-link btn-sm p-0" @onclick="() => SetRoleAsync(p, PlugRole.MainMeter)" title="Un singur contor general: cel de acum devine sub-contor"><i class="bi bi-house-door me-1"></i>Setează ca contor general</button></div>
                                }
                            </td>
                            <td>
                                <div>@p.IpAddress</div>
                                <code class="text-secondary small" title="@(p.Channel > 0 ? $"Canalul {p.Channel} al dispozitivului {p.Mac}" : "")">@p.MacLabel</code>
                            </td>
                            <td class="small text-nowrap">@(string.IsNullOrEmpty(p.SwVer) ? "—" : p.SwVer.Split(' ')[0])</td>
                            <td class="small text-nowrap">
                                <div title="Ultima dată: @UiFormat.FullLocal(p.LastSeenUtc)"><i class="bi bi-clock me-1 text-secondary"></i>@UiFormat.RelativeRo(p.LastSeenUtc, now)</div>
                                <div class="text-secondary" title="Prima dată: @UiFormat.FullLocal(p.FirstSeenUtc)">din @p.FirstSeenUtc.ToLocalTime().ToString("yyyy-MM-dd")</div>
                            </td>
                            <td style="max-width: 22rem;">
                                @if (p.IsArchived) { <span class="badge text-bg-secondary">retrasă</span> }
                                else if (!p.IsSupported)
                                {
                                    <span class="badge text-bg-warning text-wrap text-start">@TapoSupport.Describe(p.Model, p.UnsupportedReason!)</span>
                                    @if (TapoSupport.IsUnknownProtocolReason(p.UnsupportedReason))
                                    {
                                        <div class="form-text text-warning-emphasis">@TapoSupport.ThirdPartyCompatibilityHint</div>
                                    }
                                }
                                else { <span class="badge text-bg-success">activă</span> }
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleDetails(p.Id)" title="Detalii: roluri, releu"><i class="bi @(_detailsId == p.Id ? "bi-chevron-up" : "bi-info-circle")"></i></button>
                                <a class="btn btn-outline-secondary btn-sm" href="/history?plugId=@p.Id" title="Istoric"><i class="bi bi-bar-chart"></i></a>
                                @if (p.IsArchived)
                                {
                                    <button class="btn btn-outline-success btn-sm" @onclick="() => ToggleArchive(p)" title="Readu: priza e interogată din nou și reapare în /metrics"><i class="bi bi-arrow-counterclockwise"></i></button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleArchive(p)" title="Retrage: nu mai e interogată și nu mai apare în /metrics"><i class="bi bi-archive"></i></button>
                                }
                            </td>
                        </tr>
                        @if (_detailsId == p.Id)
                        {
                            <tr class="table-light">
                                <td colspan="8">
                                    <div class="row g-3 small">
                                        <div class="col-lg-7">
                                            <div class="fw-semibold mb-1"><i class="bi bi-diagram-2 me-1"></i>Roluri</div>
                                            <ul class="list-unstyled mb-1">
                                                @foreach (var role in PlugRoles.All)
                                                {
                                                    <li class="mb-1"><i class="bi @PlugRoles.Icon(role) me-1"></i><b>@PlugRoles.Name(role)</b>@(p.Role == role ? " (rolul actual)" : ""): @PlugRoles.Description(role)</li>
                                                }
                                            </ul>
                                            <div class="text-secondary">Canalele noi de contor Shelly (em1/em) pornesc ca sub-contor; prizele (Kasa, Tapo, Shelly switch/pm1) ca priză. Bifa „flux 1 s” pornește fluxul live: contorul general la fiecare secundă, prizele la 1 s cât timp puterea se schimbă și până la 10 s când stau liniștite. Implicit pornit pentru contorul general și prize, oprit pentru sub-contoare; la schimbarea rolului bifa revine la valoarea implicită a rolului.</div>
                                        </div>
                                        <div class="col-lg-5">
                                            <div class="fw-semibold mb-1"><i class="bi bi-toggle-on me-1"></i>Releu</div>
                                            @if (p.Protocol == PlugProtocols.ShellyRpc && p.IsPolled)
                                            {
                                                <RelaySwitch PlugId="p.Id" />
                                                <div class="text-secondary mt-1">Apare doar pe canalele Shelly cu releu (canalul 0 al unui contor cu <code>switch:0</code>, prizele Shelly) și când „Permite comanda releului” e pornită în Setări. Fiecare comandă e confirmată și trecută în jurnal (pagina Contor).</div>
                                            }
                                            else
                                            {
                                                <div class="text-secondary">Fără comandă: doar dispozitivele Shelly cu releu pot fi comandate (Kasa/Tapo nu, deocamdată).</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Plug>? _plugs;
    private Guid? _editingId;
    private string _editAlias = "";
    private System.Threading.Timer? _refresh;
    private bool _showArchived;
    private bool _scanning;
    private bool _adding;
    private string _manualIp = "";
    private string? _message;
    private Guid? _detailsId;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _refresh = new System.Threading.Timer(_ => InvokeAsync(ReloadAsync), null, 5000, 5000);
    }

    private async Task ReloadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<IPlugRepository>();
        _plugs = (await repo.ListAllAsync(CancellationToken.None)).ToList();
        StateHasChanged();
    }

    private static string ScanBadge(DiscoveryResultItem i) => i.Status switch
    {
        DiscoveryStatus.New => "text-bg-primary",
        DiscoveryStatus.Added => "text-bg-success",
        DiscoveryStatus.Known => "text-bg-light border",
        _ => "text-bg-warning",
    };

    private static string StatusText(DiscoveryResultItem i) => i.Status switch
    {
        DiscoveryStatus.New => "nouă",
        DiscoveryStatus.Added => "nouă (adăugată)",
        DiscoveryStatus.Known => "cunoscută",
        _ => TapoSupport.Describe(i.Plug.Info.Model, i.Plug.UnsupportedReason ?? ""),
    };

    private async Task ScanNowAsync()
    {
        _scanning = true;
        _message = null;
        StateHasChanged();
        try
        {
            var scan = await Discovery.ScanAsync(CancellationToken.None);
            _message = $"Scanare terminată: {scan.Items.Count} găsite.";
        }
        catch (Exception ex)
        {
            _message = $"Scanarea a eșuat: {ex.Message}";
        }
        finally
        {
            _scanning = false;
        }
        await ReloadAsync();
    }

    private async Task AddDiscoveredAsync(DiscoveryResultItem item)
    {
        await Discovery.AddAsync(item.Plug, CancellationToken.None);
        _message = $"Adăugată: {item.Plug.Info.Alias} ({item.Plug.IpAddress}).";
        await ReloadAsync();
    }

    private async Task AddByIpAsync()
    {
        if (!System.Net.IPAddress.TryParse(_manualIp.Trim(), out var ip) || ip.AddressFamily != System.Net.Sockets.AddressFamily.InterNetwork)
        {
            _message = $"„{_manualIp}” nu e o adresă IPv4 validă.";
            return;
        }
        _adding = true;
        _message = null;
        StateHasChanged();
        try
        {
            var result = await Discovery.AddByIpAsync(ip, CancellationToken.None);
            _message = result.Message;
        }
        catch (Exception ex)
        {
            _message = $"Adăugarea a eșuat: {ex.Message}";
        }
        finally
        {
            _adding = false;
        }
        await ReloadAsync();
    }

    private void StartEdit(Plug p)
    {
        _editingId = p.Id;
        _editAlias = p.Alias;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editAlias = "";
    }

    private async Task SaveAlias(Guid plugId)
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<IPlugRepository>();
        await repo.SetAliasAsync(plugId, _editAlias, isCustom: true, CancellationToken.None);
        _editingId = null;
        _editAlias = "";
        await ReloadAsync();
    }

    private async Task ToggleArchive(Plug p)
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<IPlugRepository>();
        await repo.SetArchivedAsync(p.Id, !p.IsArchived, CancellationToken.None);
        await ReloadAsync();
    }

    private void ToggleDetails(Guid plugId) => _detailsId = _detailsId == plugId ? null : plugId;

    private async Task SetStreamAsync(Plug p, bool enabled)
    {
        using (var scope = ScopeFactory.CreateScope())
            await scope.ServiceProvider.GetRequiredService<IPlugRepository>().SetStreamEnabledAsync(p.Id, enabled, CancellationToken.None);
        _message = $"„{p.Alias}”: flux live {(enabled ? "pornit" : "oprit")} (se aplică în ≤ 10 s).";
        await ReloadAsync();
    }

    private async Task SetRoleAsync(Plug p, PlugRole role)
    {
        if (p.Role == role || p.IsArchived) return;
        using (var scope = ScopeFactory.CreateScope())
            await scope.ServiceProvider.GetRequiredService<IPlugRepository>().SetRoleAsync(p.Id, role, CancellationToken.None);
        _message = role == PlugRole.MainMeter
            ? $"„{p.Alias}” e acum contorul general (cel vechi, dacă exista, a devenit sub-contor). Se aplică la următoarea citire (≤ 10 s)."
            : $"„{p.Alias}”: rol {PlugRoles.Name(role)}. Se aplică la următoarea citire (≤ 10 s).";
        await ReloadAsync();
    }

    public void Dispose() => _refresh?.Dispose();
}
