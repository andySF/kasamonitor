@page "/"
@rendermode InteractiveServer
@using KasaMonitor.Workers
@using KasaMonitor.Web.Ui
@inject IPlugStateBroadcaster Broadcaster
@inject KasaMonitor.Core.Costing.TariffCalculator DefaultTariff
@inject IKasaSettingsService KasaSettings
@inject DeviceDetailsService Details
@inject IServiceScopeFactory ScopeFactory
@implements IDisposable

<PageTitle>KasaMonitor — Dashboard</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h1>
    <div class="d-flex flex-wrap gap-2">
        <div class="card px-3 py-2 text-center">
            <div class="small text-secondary" title="Suma prizelor; contoarele de energie (Shelly EM) nu intră în total">Putere acum</div>
            <div class="fs-5 fw-semibold"><i class="bi bi-lightning-charge text-warning"></i> @TotalPowerW.ToString("0") W</div>
            <div class="small text-secondary">@EnergyFormat.Lei(HourlyCostRon)/h</div>
        </div>
        <div class="card px-3 py-2 text-center">
            <div class="small text-secondary" title="@DayCountersNote">Azi (toate prizele)</div>
            <div class="fs-5 fw-semibold">@(TodayTotalWh is { } t ? EnergyFormat.Kwh(t) + " kWh" : "—")</div>
            <div class="small text-secondary">@(TodayTotalWh is { } tc ? EnergyFormat.Lei(_tariff.CostFromWh(tc)) : "")</div>
        </div>
        <div class="card px-3 py-2 text-center">
            <div class="small text-secondary" title="@DayCountersNote">Luna (toate prizele)</div>
            <div class="fs-5 fw-semibold">@(MonthTotalWh is { } m ? EnergyFormat.Kwh(m) + " kWh" : "—")</div>
            <div class="small text-secondary">@(MonthTotalWh is { } mc ? EnergyFormat.Lei(_tariff.CostFromWh(mc)) : "")</div>
        </div>
    </div>
</div>

@if (_states.Count == 0)
{
    <div class="alert alert-secondary">No plugs discovered yet — check the broadcast network configuration and wait ~30 s after startup.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-3">
        @foreach (var s in _states.Values.OrderBy(s => s.Alias))
        {
            var open = _openId == s.PlugId;
            <div class="col">
                <div class="card h-100 border-start border-4 @(s.IsOnline ? "border-success" : "border-danger")">
                    <div class="card-body pb-2">
                        <div class="d-flex justify-content-between align-items-start">
                            <a class="h5 card-title text-decoration-none text-body mb-1" href="/history?plugId=@s.PlugId" title="History">@s.Alias</a>
                            <span class="badge @(s.IsOnline ? "text-bg-success" : "text-bg-danger")">@(s.IsOnline ? "online" : "offline")</span>
                        </div>
                        <div class="mb-2">
                            @if (!string.IsNullOrEmpty(s.Model)) { <span class="badge text-bg-light border me-1">@s.Model</span> }
                            <span class="badge @UiFormat.ProtocolBadge(s.Protocol)">@s.Protocol</span>
                        </div>
                        @if (s.LastReading is not null)
                        {
                            <div class="fs-4 fw-semibold">
                                @((s.LastReading.PowerMw / 1000.0).ToString("0.0")) W
                                @if (s.Protocol == PlugProtocols.ShellyRpc && s.LastReading.PowerMw < ReversedBelowMw)
                                {
                                    <span class="badge text-bg-warning fs-6 align-middle" title="Putere negativă: clema e montată invers (sau energia e livrată în rețea). Se poate corecta din aplicația Shelly (reverse); KasaMonitor doar citește.">inversat?</span>
                                }
                            </div>
                            <div class="small text-secondary">
                                @if (s.LastReading.VoltageMv is { } mv)
                                {
                                    <span class="me-2">@((mv / 1000.0).ToString("0.0")) V</span>
                                }
                                @if (s.LastReading.CurrentMa is { } ma)
                                {
                                    <span class="me-2">@((ma / 1000.0).ToString("0.000")) A</span>
                                }
                                @if (s.LastReading.PowerFactor is { } pf)
                                {
                                    <span class="me-2" title="Factor de putere">pf @pf.ToString("0.00")</span>
                                }
                                @if (s.Protocol is PlugProtocols.Legacy or PlugProtocols.ShellyRpc && s.LastReading.TotalWh is { } totalWh)
                                {
                                    <span title="Contorul cumulativ al prizei">Total @((totalWh / 1000.0).ToString("0.000")) kWh</span>
                                }
                            </div>
                            @if (s.LastReading.TodayWh is { } todayWh)
                            {
                                <div class="small text-secondary">@EnergyFormat.Line("Azi", todayWh, _tariff)</div>
                            }
                            @if (s.LastReading.MonthWh is { } monthWh)
                            {
                                <div class="small text-secondary">@EnergyFormat.Line("Luna", monthWh, _tariff)</div>
                            }
                        }
                    </div>
                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center small">
                        <span class="text-secondary" title="@UiFormat.FullLocal(s.LastSampleUtc)"><i class="bi bi-clock me-1"></i>@((_now - s.LastSampleUtc).TotalSeconds.ToString("0")) s ago</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleDetailsAsync(s.PlugId)" title="Device settings read from the plug">
                            <i class="bi bi-gear me-1"></i>Details <i class="bi @(open ? "bi-chevron-up" : "bi-chevron-down")"></i>
                        </button>
                    </div>
                    @if (open)
                    {
                        <div class="card-body border-top pt-2 small">
                            @if (_loadingDetails)
                            {
                                <span class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Reading the plug…</span>
                            }
                            else if (_details is { } d)
                            {
                                @foreach (var section in d.Items.GroupBy(i => i.Section))
                                {
                                    <div class="text-uppercase text-secondary fw-semibold mt-2" style="font-size: .7rem;"><i class="bi @SectionIcon(section.Key) me-1"></i>@section.Key</div>
                                    <dl class="row mb-0">
                                        @foreach (var item in section)
                                        {
                                            <dt class="col-6 fw-normal text-secondary">@item.Label</dt>
                                            <dd class="col-6 mb-1">@item.Value</dd>
                                        }
                                    </dl>
                                }
                                @foreach (var err in d.Errors)
                                {
                                    <div class="text-warning-emphasis mt-1"><i class="bi bi-info-circle me-1"></i>@err</div>
                                }
                                <div class="d-flex justify-content-between align-items-center mt-2 text-secondary">
                                    <span title="@UiFormat.FullLocal(d.ReadAtUtc)">read @((DateTimeOffset.UtcNow - d.ReadAtUtc).TotalSeconds.ToString("0")) s ago</span>
                                    <button class="btn btn-link btn-sm p-0" @onclick="() => LoadDetailsAsync(s.PlugId, true)" title="Read again"><i class="bi bi-arrow-clockwise"></i></button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private Dictionary<Guid, PlugLiveState> _states = new();
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private System.Threading.Timer? _refreshTimer;
    private Guid? _openId;
    private bool _loadingDetails;
    private DeviceDetails? _details;

    /// <summary>"inversat?" is shown below -10 W (small negative readings of an idle channel are noise).</summary>
    private const long ReversedBelowMw = -10_000;

    private const string DayCountersNote =
        "Suma contoarelor de azi / din lună raportate de prize (Kasa, Tapo). Prizele Shelly nu au astfel de contoare în dispozitiv și nu sunt incluse aici (istoricul lor zilnic e în History); contoarele de energie (Shelly EM) nu intră în totaluri.";

    /// <summary>Plugs that count towards the header totals: energy meters (Shelly EM) already include them.</summary>
    private IEnumerable<PlugLiveState> Counted => _states.Values.Where(s => PlugChannel.CountsInTotals(s.Model));

    private double TotalPowerW => Counted
        .Where(s => s.IsOnline && s.LastReading is not null)
        .Sum(s => s.LastReading!.PowerMw / 1000.0);

    private KasaMonitor.Core.Costing.TariffCalculator _tariff = null!;
    private int _ticks;

    private decimal HourlyCostRon => _tariff.CostFromWh((long)TotalPowerW);

    private long? TodayTotalWh => EnergyFormat.Sum(Counted.Select(s => s.LastReading), r => r.TodayWh);
    private long? MonthTotalWh => EnergyFormat.Sum(Counted.Select(s => s.LastReading), r => r.MonthWh);

    /// <summary>Tariff saved in /settings (falls back to the startup value); re-read every 30 s.</summary>
    private async Task LoadTariffAsync()
    {
        try { _tariff = new KasaMonitor.Core.Costing.TariffCalculator((await KasaSettings.GetAsync(CancellationToken.None)).TariffRonPerKwh); }
        catch (Exception) { _tariff ??= DefaultTariff; }
    }

    protected override async Task OnInitializedAsync()
    {
        _tariff = DefaultTariff;
        await LoadTariffAsync();
        _states = Broadcaster.Snapshot().ToDictionary(kv => kv.Key, kv => kv.Value);
        Broadcaster.StateChanged += OnStateChanged;
        Broadcaster.StateRemoved += OnStateRemoved;
        _refreshTimer = new System.Threading.Timer(_ =>
            InvokeAsync(async () =>
            {
                _now = DateTimeOffset.UtcNow;
                if (++_ticks % 30 == 0) await LoadTariffAsync();
                StateHasChanged();
            }),
            null, 1000, 1000);
    }

    private static string SectionIcon(string section) => section switch
    {
        DeviceDetails.Sections.State => "bi-power",
        DeviceDetails.Sections.Timer => "bi-stopwatch",
        DeviceDetails.Sections.Protection => "bi-shield-check",
        DeviceDetails.Sections.Network => "bi-wifi",
        DeviceDetails.Sections.Device => "bi-cpu",
        DeviceDetails.Sections.Time => "bi-clock",
        DeviceDetails.Sections.Schedules => "bi-calendar-event",
        DeviceDetails.Sections.Meter => "bi-speedometer",
        _ => "bi-info-circle",
    };

    private async Task ToggleDetailsAsync(Guid plugId)
    {
        if (_openId == plugId)
        {
            _openId = null;
            return;
        }
        _openId = plugId;
        await LoadDetailsAsync(plugId, false);
    }

    private async Task LoadDetailsAsync(Guid plugId, bool force)
    {
        _loadingDetails = true;
        _details = null;
        StateHasChanged();
        try
        {
            Plug? plug;
            using (var scope = ScopeFactory.CreateScope())
                plug = (await scope.ServiceProvider.GetRequiredService<IPlugRepository>().ListAllAsync(CancellationToken.None))
                    .FirstOrDefault(p => p.Id == plugId);
            var details = plug is null
                ? new DeviceDetails(DateTimeOffset.UtcNow, Array.Empty<DeviceDetailItem>(), new[] { "Plug not found." })
                : await Details.GetAsync(plug, force, CancellationToken.None);
            if (_openId == plugId) _details = details;
        }
        catch (Exception ex)
        {
            _details = new DeviceDetails(DateTimeOffset.UtcNow, Array.Empty<DeviceDetailItem>(), new[] { ex.Message });
        }
        finally
        {
            _loadingDetails = false;
        }
    }

    private void OnStateChanged(PlugLiveState state)
    {
        InvokeAsync(() =>
        {
            _states[state.PlugId] = state;
            _now = DateTimeOffset.UtcNow;
            StateHasChanged();
        });
    }

    private void OnStateRemoved(Guid plugId)
    {
        InvokeAsync(() =>
        {
            _states.Remove(plugId);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Broadcaster.StateChanged -= OnStateChanged;
        Broadcaster.StateRemoved -= OnStateRemoved;
        _refreshTimer?.Dispose();
    }
}
