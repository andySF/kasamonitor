@using KasaMonitor.Core.Heating
@using KasaMonitor.Web.Ui
@inject IServiceScopeFactory ScopeFactory

@* /centrala "Cronologie arzător": when the burner burns and for what (heating / hot water / unknown), with the
   temperatures, the modulation and the pump on the same time axis. Rule: BurnerTimeline (Core). *@
<div class="card mt-3">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
        <span class="fw-semibold"><i class="bi bi-clock-history me-2"></i>Cronologie arzător</span>
        <span class="text-secondary" style="cursor: help" title="@RuleNote">ⓘ</span>
        <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="Interval">
            @foreach (var (span, name) in Spans)
            {
                <button type="button" class="btn @(_span == span ? "btn-primary" : "btn-outline-primary")" @onclick="() => SelectSpan(span)">@name</button>
            }
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="Navigare">
            <button type="button" class="btn btn-outline-secondary" title="Intervalul anterior" @onclick="() => Move(-1)">◀</button>
            <button type="button" class="btn btn-outline-secondary" title="Intervalul următor" disabled="@(_end is null)" @onclick="() => Move(1)">▶</button>
        </div>
    </div>
    <div class="card-body">
        <div class="small text-secondary mb-2">
            @UiFormat.FullLocal(_from)[..16] – @(_end is null ? "acum" : UiFormat.FullLocal(_to)[..16])
            @if (_end is not null) { <button type="button" class="btn btn-link btn-sm p-0 ms-2 align-baseline" @onclick="GoToNow">la zi</button> }
        </div>

        @if (_error is { } err)
        {
            <div class="alert alert-warning mb-0">Cronologia nu a putut fi încărcată: @err</div>
        }
        else if (!_loaded)
        {
            <p class="text-secondary mb-0"><span class="spinner-border spinner-border-sm me-2"></span>Se încarcă…</p>
        }
        else if (_temps.Count == 0)
        {
            <div class="small text-secondary">Nu există citiri ale centralei în acest interval.</div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-3 small mb-1">
                @foreach (var (purpose, name, color) in Purposes)
                {
                    var (count, seconds) = Totals(purpose);
                    <span><span class="d-inline-block rounded-1 me-1 align-middle" style="width: .9rem; height: .9rem; background: @color"></span>@name: <b>@UiFormat.DurationRo(seconds)</b>@(count > 0 ? $" ({count} {(count == 1 ? "interval" : "intervale")})" : "")</span>
                }
                <span class="text-secondary">arzător pornit @HeatingFormat.Number(OnShare() * 100, 0) % din interval</span>
            </div>
            @if (_band.Count == 0)
            {
                <div class="small text-secondary border rounded px-2 py-1 mb-2">Arzătorul n-a pornit în acest interval.</div>
            }
            else
            {
                <ApexChart @key="_key" TItem="BandItem" Options="_bandOptions" Height="90" XAxisType="XAxisType.Datetime">
                    <ChildContent>
                        @foreach (var (purpose, name, color) in Purposes)
                        {
                            var items = _band.Where(b => b.Segment.Purpose == purpose).ToList();
                            if (items.Count > 0)
                            {
                                <ApexRangeSeries TItem="BandItem" Items="items" Name="@name" Color="@color" XValue="@(b => b.Row)" YMinValue="@(b => b.StartMs)" YMaxValue="@(b => b.EndMs)" />
                            }
                        }
                    </ChildContent>
                    <ApexPointTooltip>
                        @{ var seg = context.DataPoint.Items.First().Segment; }
                        <div class="p-2 small">
                            <div class="fw-semibold">@PurposeName(seg.Purpose)@(seg.Ongoing ? " (în curs)" : "")</div>
                            <div>@UiFormat.FullLocal(seg.StartUtc)[11..16] – @UiFormat.FullLocal(seg.EndUtc)[11..16] · @UiFormat.DurationRo(seg.Duration.TotalSeconds)</div>
                            <div>modulare medie: @(seg.AvgModulationPct is { } m ? HeatingFormat.Number(m, 0) + " %" : "—")</div>
                            @if (GasText(seg) is { } gas) { <div>gaz (contorul centralei): @gas</div> }
                            <div class="text-secondary">@seg.Reason</div>
                        </div>
                    </ApexPointTooltip>
                </ApexChart>
            }
            <ApexChart @key="(_key + 100000)" TItem="TempPoint" Options="_tempOptions" Height="230" XAxisType="XAxisType.Datetime">
                <ApexPointSeries TItem="TempPoint" Items="_temps" Name="Tur (°C)" Color="#D55E00" SeriesType="SeriesType.Line" XValue="@(p => p.Ms)" YValue="@(p => p.SupplyC)" />
                <ApexPointSeries TItem="TempPoint" Items="_temps" Name="Apă caldă (°C)" Color="#0072B2" SeriesType="SeriesType.Line" XValue="@(p => p.Ms)" YValue="@(p => p.DhwC)" />
                <ApexPointSeries TItem="TempPoint" Items="_temps" Name="Țintă apă caldă (°C)" Color="#56B4E9" SeriesType="SeriesType.Line" XValue="@(p => p.Ms)" YValue="@(p => p.DhwTargetC)" Stroke="@(new SeriesStroke { Width = 2, DashSpace = 5 })" />
                <ApexPointSeries TItem="TempPoint" Items="_temps" Name="Cameră (°C)" Color="#009E73" SeriesType="SeriesType.Line" XValue="@(p => p.Ms)" YValue="@(p => p.RoomC)" />
            </ApexChart>
            <ApexChart @key="(_key + 200000)" TItem="TempPoint" Options="_modOptions" Height="150" XAxisType="XAxisType.Datetime">
                <ApexPointSeries TItem="TempPoint" Items="_temps" Name="Modulare (%)" Color="#CC79A7" SeriesType="SeriesType.Area" XValue="@(p => p.Ms)" YValue="@(p => p.ModulationPct)" />
                <ApexPointSeries TItem="TempPoint" Items="_temps" Name="Pompă (%)" Color="#999999" SeriesType="SeriesType.Line" XValue="@(p => p.Ms)" YValue="@(p => p.PumpPct)" />
            </ApexChart>
        }
    </div>
</div>

@code {
    public sealed record BandItem(string Row, decimal StartMs, decimal EndMs, BurnerSegment Segment);
    public sealed record TempPoint(long Ms, decimal? SupplyC, decimal? DhwC, decimal? DhwTargetC, decimal? RoomC, decimal? ModulationPct, decimal? PumpPct);

    [Parameter, EditorRequired] public Guid DeviceId { get; set; }

    /// <summary>Changes when the boiler was read again (the parent passes the poll time): the live window reloads.</summary>
    [Parameter] public DateTimeOffset? LastReadUtc { get; set; }

    private static readonly (TimeSpan Span, string Name)[] Spans =
    {
        (TimeSpan.FromHours(6), "6 h"), (TimeSpan.FromHours(24), "24 h"), (TimeSpan.FromDays(3), "3 zile"), (TimeSpan.FromDays(7), "7 zile"),
    };

    private static readonly (BurnerPurpose Purpose, string Name, string Color)[] Purposes =
    {
        (BurnerPurpose.Heating, "Încălzire", "#D55E00"),
        (BurnerPurpose.Dhw, "Apă caldă", "#0072B2"),
        (BurnerPurpose.Unknown, "Arde, scop necunoscut", "#555555"),
    };

    /// <summary>At most this many points per line: a 7-day window at 120 s (~5000 readings) is thinned.</summary>
    private const int MaxPoints = 1500;

    private const string RuleNote =
        "Scopul arderii nu vine de la centrală (API-ul Viessmann nu are un semnal „încălzește apa caldă”); KasaMonitor îl deduce pe fiecare interval " +
        "în care arzătorul e pornit (o citire lipsă de cel mult 5 min nu rupe intervalul): (a) contoarele de gaz „azi” ale centralei, care se " +
        "actualizează cu întârziere, de la citirea dinaintea intervalului până la cel mult 60 min după el, dar nu dincolo de arderea următoare: a crescut " +
        "doar apa caldă → apă caldă, doar încălzirea → încălzire, ambele → intervalul se împarte proporțional dacă e mai lung de 10 min (încălzirea " +
        "întâi), altfel necunoscut; (b) doar dacă niciun contor n-a crescut (pas 0,1 m³), pentru centrala mixtă (senzorul apei calde urmează turul): " +
        "apă caldă când apa caldă urcă cu ≥ 2 °C mai mult decât turul, sau turul stă (< 1 °C) și apa caldă urcă ≥ 2 °C; încălzire când turul urcă " +
        "≥ 2 °C și apa caldă nu-l depășește; altfel necunoscut. O ardere în curs poate rămâne „necunoscut” până se mișcă un contor. Un segment ține " +
        "de la prima citire cu arzătorul pornit până la citirea următoare, deci pornirile mai scurte decât o citire nu se văd.";

    private TimeSpan _span = TimeSpan.FromHours(24);
    private DateTimeOffset? _end;   // null = up to now (follows the new readings)
    private DateTimeOffset _from, _to;
    private bool _loaded;
    private string? _error;
    private int _key;
    private DateTimeOffset? _loadedFor;
    private List<BurnerSegment> _segments = new();
    private List<BandItem> _band = new();
    private List<TempPoint> _temps = new();
    private ApexChartOptions<BandItem> _bandOptions = new();
    private ApexChartOptions<TempPoint> _tempOptions = new();
    private ApexChartOptions<TempPoint> _modOptions = new();

    protected override async Task OnInitializedAsync()
    {
        _loadedFor = LastReadUtc;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && LastReadUtc != _loadedFor)
        {
            _loadedFor = LastReadUtc;
            // A new reading changes only the window that ends now; a past window keeps its charts.
            if (_end is null) await LoadAsync();
        }
    }

    private async Task SelectSpan(TimeSpan span)
    {
        _span = span;
        await LoadAsync();
    }

    private async Task Move(int direction)
    {
        var now = DateTimeOffset.UtcNow;
        var end = (_end ?? now) + direction * _span;
        _end = end >= now ? null : end;
        await LoadAsync();
    }

    private async Task GoToNow()
    {
        _end = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var now = DateTimeOffset.UtcNow;
            var to = _end ?? now;
            var from = to - _span;
            var requested = (_span, _end);
            using var scope = ScopeFactory.CreateScope();
            var repo = scope.ServiceProvider.GetRequiredService<KasaMonitor.Core.Abstractions.IHeatingRepository>();
            // One hour on each side: the reading before a run and the one after it belong to the rule.
            var readings = await repo.ListReadingsAsync(DeviceId, from.AddHours(-1), to.AddHours(1), CancellationToken.None);
            // A slower earlier request must not overwrite the window chosen since.
            if (requested != (_span, _end)) return;
            Build(readings, from, to, now);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loaded = true;
    }

    private void Build(IReadOnlyList<HeatingReading> readings, DateTimeOffset from, DateTimeOffset to, DateTimeOffset now)
    {
        _from = from;
        _to = to;
        var cadence = BurnerTimeline.Cadence(readings.Where(r => r.BurnerActive is not null).ToList());
        _segments = BurnerTimeline.Build(readings)
            // A run still going is drawn up to one cadence after its last reading (never past now).
            .Select(s => s.Ongoing ? s with { EndUtc = Min(s.EndUtc + cadence, now) } : s)
            .Where(s => s.EndUtc > from && s.StartUtc < to)
            .ToList();
        _band = _segments.Select(s => new BandItem("Arzător", Ms(Max(s.StartUtc, from)), Ms(Min(s.EndUtc, to)), s)).ToList();

        var inWindow = readings.Where(r => r.TsUtc >= from && r.TsUtc <= to).ToList();
        var step = Math.Max(1, (int)Math.Ceiling(inWindow.Count / (double)MaxPoints));
        _temps = inWindow.Where((_, i) => i % step == 0 || i == inWindow.Count - 1)
            .Select(r => new TempPoint(r.TsUtc.ToUnixTimeMilliseconds(), Dec(r.SupplyTempC), Dec(r.DhwTempC), Dec(r.DhwTargetC), Dec(r.RoomTempC),
                Dec(r.ModulationPct), Dec(r.PumpPct)))
            .ToList();

        long min = from.ToUnixTimeMilliseconds(), max = to.ToUnixTimeMilliseconds();
        _bandOptions = BandOptions(min, max);
        _tempOptions = LineOptions(min, max, null, 1, Curve.Straight);
        _modOptions = LineOptions(min, max, 100, 1, Curve.Stepline);
        _key++;
    }

    /// <summary>Same fixed y-axis label width on the three charts, so their time axes line up.</summary>
    private static List<YAxis> Axis(double? max, bool showLabels = true) =>
        new() { new() { Min = max is null ? null : 0, Max = max, DecimalsInFloat = 0, Labels = new YAxisLabels { MinWidth = 48, MaxWidth = 48, Show = showLabels } } };

    private static ApexChartOptions<BandItem> BandOptions(long min, long max) => new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false }, Animations = new Animations { Enabled = false }, Zoom = new Zoom { Enabled = false } },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true, BarHeight = "70%", RangeBarGroupRows = true } },
        DataLabels = new DataLabels { Enabled = false },
        Legend = new Legend { Show = false },
        Xaxis = new XAxis { Min = min, Max = max, Labels = new XAxisLabels { DatetimeUTC = false } },
        Yaxis = Axis(null),
        Tooltip = new Tooltip { Enabled = true },
    };

    private static ApexChartOptions<TempPoint> LineOptions(long min, long max, double? yMax, int width, Curve curve) => new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false }, Animations = new Animations { Enabled = false }, Zoom = new Zoom { Enabled = false } },
        Stroke = new Stroke { Width = width + 1, Curve = curve },
        DataLabels = new DataLabels { Enabled = false },
        Xaxis = new XAxis { Min = min, Max = max, Labels = new XAxisLabels { DatetimeUTC = false } },
        Yaxis = Axis(yMax),
        Tooltip = new Tooltip { Shared = true, X = new TooltipX { Format = "dd.MM HH:mm" } },
    };

    private (int Count, double Seconds) Totals(BurnerPurpose purpose)
    {
        var items = _band.Where(b => b.Segment.Purpose == purpose).ToList();
        return (items.Count, (double)items.Sum(b => b.EndMs - b.StartMs) / 1000);
    }

    private double OnShare()
    {
        var window = (_to - _from).TotalMilliseconds;
        return window <= 0 ? 0 : (double)_band.Sum(b => b.EndMs - b.StartMs) / window;
    }

    private static string PurposeName(BurnerPurpose p) => Purposes.FirstOrDefault(x => x.Purpose == p).Name ?? "oprit";

    private static string? GasText(BurnerSegment s)
    {
        var parts = new List<string>();
        if (s.GasHeatingM3 is > 0.04) parts.Add("încălzire +" + HeatingFormat.Number(s.GasHeatingM3, 1) + " m³");
        if (s.GasDhwM3 is > 0.04) parts.Add("apă caldă +" + HeatingFormat.Number(s.GasDhwM3, 1) + " m³");
        return parts.Count == 0 ? null : string.Join(", ", parts);
    }

    private static decimal Ms(DateTimeOffset t) => t.ToUnixTimeMilliseconds();
    private static DateTimeOffset Min(DateTimeOffset a, DateTimeOffset b) => a < b ? a : b;
    private static DateTimeOffset Max(DateTimeOffset a, DateTimeOffset b) => a > b ? a : b;
    private static decimal? Dec(double? v) => v is { } x ? Math.Round((decimal)x, 1) : null;
}
