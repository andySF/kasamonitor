@page "/settings"
@rendermode InteractiveServer
@using KasaMonitor.Workers
@inject IServiceScopeFactory ScopeFactory
@inject IKasaSettingsService KasaSettings
@inject ReadingsRetentionService Retention

<PageTitle>KasaMonitor — Setări</PageTitle>
<h1 class="h3 mb-3"><i class="bi bi-gear me-2"></i>Setări</h1>

@if (_loading)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Se încarcă…</p>
}
else
{
    <div class="row g-3" style="max-width: 1100px;">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-broadcast me-2"></i>Descoperire</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="autoDiscovery" @bind="_autoDiscovery" />
                        <label class="form-check-label" for="autoDiscovery">Descoperire automată</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="interval">Interval descoperire (minute)</label>
                        <input class="form-control" id="interval" @bind="_intervalMin" type="number" min="@KasaSettingsService.MinIntervalMinutes" max="@KasaSettingsService.MaxIntervalMinutes" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="broadcast">Rețele broadcast (separate prin virgulă)</label>
                        <input class="form-control" id="broadcast" @bind="_broadcast" placeholder="192.168.1.255" />
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="autoAdd" @bind="_autoAdd" />
                        <label class="form-check-label" for="autoAdd">Adaugă automat prizele găsite</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-cloud me-2"></i>Cont TP-Link (prize Tapo, KLAP / AES)</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="tapoUser">Utilizator (e-mail)</label>
                        <input class="form-control" id="tapoUser" @bind="_tapoUser" autocomplete="off" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="tapoPassword">Parolă</label>
                        <input class="form-control" id="tapoPassword" @bind="_tapoPassword" type="password" autocomplete="new-password"
                               placeholder="@(_hasTapoPassword ? "•••••••• (setată; lasă gol ca să rămână)" : "nesetată")" />
                    </div>
                    @if (_hasTapoPassword)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="clearPw" @bind="_clearTapoPassword" />
                            <label class="form-check-label" for="clearPw">Șterge parola</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-sliders me-2"></i>Altele</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="tariff">Tarif (RON / kWh)</label>
                        <input class="form-control" id="tariff" @bind="_tariff" type="number" step="0.01" />
                    </div>
                    <div class="mb-1">
                        <label class="form-label" for="poll">Interval interogare (secunde)</label>
                        <input class="form-control" id="poll" @bind="_pollSec" type="number" min="5" max="300" />
                    </div>
                    <div class="form-text">Tariful și intervalul de interogare se citesc la pornire din variabilele de mediu.</div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold"><i class="bi bi-database me-2"></i>Date</div>
                <div class="card-body">
                    <label class="form-label" for="retention">Păstrează citirile brute (luni, 0 = nelimitat)</label>
                    <input class="form-control" id="retention" @bind="_retentionMonths" type="number" min="0" max="@KasaSettingsService.MaxRetentionMonths" />
                    <div class="form-text">
                        Citirile brute sunt valorile la fiecare interogare (implicit 10 s): ≈ 128 octeți/citire în SQLite, adică ≈ 1,1 MB pe priză pe zi,
                        ≈ 400 MB pe priză pe an (6 prize ≈ 2,4 GB/an). Istoricul zilnic (kWh/zi) și agregatele pe minut (≈ 65 MB pe priză pe an)
                        nu se șterg niciodată, indiferent de această setare. La o valoare &gt; 0, citirile mai vechi se șterg o dată pe zi.
                    </div>
                </div>
            </div>
        </div>

        @if (_pendingPlan is { } plan)
        {
            <div class="col-12">
                <div class="alert alert-warning mb-0">
                    <p class="mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Se vor șterge <b>@plan.RowsToDelete.ToString("N0")</b> citiri mai vechi de <b>@plan.CutoffUtc!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</b>. Confirmi?</p>
                    <button class="btn btn-danger btn-sm me-2" @onclick="ConfirmAsync" disabled="@_deleting">
                        <i class="bi bi-trash me-1"></i>@(_deleting ? "Se șterge…" : "Da, salvează și șterge")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm me-2" @onclick="CancelConfirm" disabled="@_deleting"><i class="bi bi-x-lg me-1"></i>Renunță</button>
                    <span class="small text-secondary">Fără confirmare nu se salvează nimic și nu se șterge nimic.</span>
                </div>
            </div>
        }

        <div class="col-12 d-flex align-items-center gap-3">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(_pendingPlan is not null)"><i class="bi bi-save me-1"></i>Salvează</button>
            @if (_saved) { <span class="text-success"><i class="bi bi-check-circle me-1"></i>Salvat.@(_deletedMessage is null ? "" : " " + _deletedMessage)</span> }
            @if (_error is not null) { <span class="text-danger"><i class="bi bi-x-circle me-1"></i>@_error</span> }
        </div>
        <div class="col-12 form-text">Setările de descoperire, contul TP-Link și retenția se aplică fără repornire (la următorul ciclu).</div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saved;
    private string? _error;
    private decimal _tariff;
    private int _pollSec;
    private bool _autoDiscovery;
    private int _intervalMin;
    private string _broadcast = "";
    private bool _autoAdd;
    private string _tapoUser = "";
    private string _tapoPassword = "";
    private bool _hasTapoPassword;
    private bool _clearTapoPassword;
    private int _retentionMonths;
    private RetentionPlan? _pendingPlan;
    private bool _deleting;
    private string? _deletedMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<ISettingsRepository>();

        var tariffStr = await repo.GetAsync("TariffRonPerKwh", CancellationToken.None);
        _tariff = decimal.TryParse(tariffStr, System.Globalization.CultureInfo.InvariantCulture, out var t) ? t : 1.30m;

        var pollStr = await repo.GetAsync("PollIntervalSeconds", CancellationToken.None);
        _pollSec = int.TryParse(pollStr, out var p) ? p : 10;

        var s = await KasaSettings.GetAsync(CancellationToken.None);
        _autoDiscovery = s.AutoDiscoveryEnabled;
        _intervalMin = s.AutoDiscoveryIntervalMinutes;
        _broadcast = s.BroadcastNetworks;
        _autoAdd = s.AutoAddDiscoveredPlugs;
        _tapoUser = s.TapoUsername;
        _hasTapoPassword = s.HasTapoPassword;
        _tapoPassword = "";
        _clearTapoPassword = false;
        _retentionMonths = s.ReadingsRetentionMonths;
    }

    private async Task SaveAsync()
    {
        _error = null;
        _deletedMessage = null;
        var (_, invalid) = KasaSettingsService.ParseBroadcastNetworks(_broadcast);
        if (invalid.Count > 0)
        {
            _error = $"Adrese broadcast invalide: {string.Join(", ", invalid)}";
            return;
        }
        _retentionMonths = Math.Clamp(_retentionMonths, 0, KasaSettingsService.MaxRetentionMonths);

        // Ask before anything is saved when the new retention would delete existing readings.
        var plan = await Retention.PlanAsync(_retentionMonths, CancellationToken.None);
        if (plan.NeedsConfirmation)
        {
            _pendingPlan = plan;
            return;
        }
        await SaveCoreAsync();
    }

    private void CancelConfirm() => _pendingPlan = null;

    private async Task ConfirmAsync()
    {
        if (_pendingPlan is not { } plan) return;
        _retentionMonths = plan.Months;
        _deleting = true;
        StateHasChanged();
        try
        {
            if (!await SaveSettingsAsync()) return;
            var deleted = await Retention.ApplyAsync(plan.Months, CancellationToken.None);
            _deletedMessage = $"Au fost șterse {deleted:N0} citiri.";
        }
        finally
        {
            _deleting = false;
            _pendingPlan = null;
        }
        await AfterSaveAsync();
    }

    private async Task SaveCoreAsync()
    {
        if (await SaveSettingsAsync()) await AfterSaveAsync();
    }

    private async Task<bool> SaveSettingsAsync()
    {
        try
        {
            await KasaSettings.SaveAsync(new KasaSettingsUpdate(
                _autoDiscovery, _intervalMin, _broadcast, _autoAdd, _tapoUser,
                NewTapoPassword: _tapoPassword, ClearTapoPassword: _clearTapoPassword,
                ReadingsRetentionMonths: _retentionMonths), CancellationToken.None);
        }
        catch (FormatException ex)
        {
            _error = ex.Message;
            return false;
        }

        using (var scope = ScopeFactory.CreateScope())
        {
            var repo = scope.ServiceProvider.GetRequiredService<ISettingsRepository>();
            await repo.SetAsync("TariffRonPerKwh", _tariff.ToString(System.Globalization.CultureInfo.InvariantCulture), CancellationToken.None);
            await repo.SetAsync("PollIntervalSeconds", _pollSec.ToString(), CancellationToken.None);
        }
        return true;
    }

    private async Task AfterSaveAsync()
    {
        await LoadAsync();
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
        StateHasChanged();
    }
}
