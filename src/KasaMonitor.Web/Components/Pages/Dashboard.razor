@page "/prize"
@rendermode InteractiveServer
@using KasaMonitor.Workers
@using KasaMonitor.Web.Ui
@inject IPlugStateBroadcaster Broadcaster
@inject KasaMonitor.Core.Costing.TariffCalculator DefaultTariff
@inject IKasaSettingsService KasaSettings
@inject ILiveStreamBroadcaster MeterStream
@inject HouseRestService HouseRest
@implements IDisposable

<PageTitle>KasaMonitor — Prize</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-speedometer2 me-2"></i>Prize</h1>
    <div class="d-flex flex-wrap gap-2">
        <div class="card px-3 py-2 text-center">
            <div class="small text-secondary" title="Suma prizelor (rol „priză”); contoarele (contor general, sub-contoare) nu intră în total">Putere acum</div>
            <div class="fs-5 fw-semibold"><i class="bi bi-lightning-charge text-warning"></i> @TotalPowerW.ToString("0") W</div>
            <div class="small text-secondary">@EnergyFormat.Lei(HourlyCostRon)/h</div>
        </div>
        <div class="card px-3 py-2 text-center">
            <div class="small text-secondary" title="@DayCountersNote">Azi (toate prizele)</div>
            <div class="fs-5 fw-semibold">@(TodayTotalWh is { } t ? EnergyFormat.Kwh(t) + " kWh" : "—")</div>
            <div class="small text-secondary">@(TodayTotalWh is { } tc ? EnergyFormat.Lei(_tariff.CostFromWh(tc)) : "")</div>
        </div>
        <div class="card px-3 py-2 text-center">
            <div class="small text-secondary" title="@DayCountersNote">Luna (toate prizele)</div>
            <div class="fs-5 fw-semibold">@(MonthTotalWh is { } m ? EnergyFormat.Kwh(m) + " kWh" : "—")</div>
            <div class="small text-secondary">@(MonthTotalWh is { } mc ? EnergyFormat.Lei(_tariff.CostFromWh(mc)) : "")</div>
        </div>
    </div>
</div>

@if (MainState is { } main)
{
    var mainW = KasaMonitor.Core.Metering.HouseBalance.MainW(main, MeterStream.Latest(main.PlugId), _now, LiveMaxAge);
    var rest = _rest;
    <div class="card mb-3 border-start border-4 @(main.IsOnline ? "border-primary" : "border-danger")">
        <div class="card-body d-flex flex-wrap align-items-center gap-4">
            <div>
                <a class="h5 text-decoration-none text-body mb-0" href="/contor" title="Pagina Contor"><i class="bi bi-house-door me-2"></i>Casă</a>
                <div class="small text-secondary">@main.Alias</div>
            </div>
            <div>
                <div class="small text-secondary">Putere acum</div>
                <div class="fs-4 fw-semibold">@(mainW is { } w ? w.ToString("0") + " W" : "—")</div>
            </div>
            <div title="@ReportFormat.RestTitle(rest)">
                <div class="small text-secondary">Restul casei</div>
                <div class="fs-4 fw-semibold">@ReportFormat.RestW(rest)</div>
                @if (rest?.Kind == KasaMonitor.Core.Metering.RestKind.Negative)
                {
                    <div class="small text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>@ReportFormat.NegativeText</div>
                }
                else
                {
                    <div class="small text-secondary">@ReportFormat.RestBasis(rest)</div>
                }
            </div>
            <div class="ms-auto"><RelaySwitch PlugId="main.PlugId" /></div>
        </div>
    </div>
    <NilmSummaryCard CssClass="mb-3" />
}

<HeatingCard />

@if (_states.Count == 0)
{
    <div class="alert alert-secondary">No plugs discovered yet — check the broadcast network configuration and wait ~30 s after startup.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-3">
        @foreach (var s in _states.Values.OrderBy(s => s.Alias))
        {
            <div class="col">
                <div class="card h-100 border-start border-4 @(s.IsOnline ? "border-success" : "border-danger")">
                    <div class="card-body pb-2">
                        <div class="d-flex justify-content-between align-items-start">
                            <a class="h5 card-title text-decoration-none text-body mb-1" href="/history?plug=@s.PlugId#curent" title="Istoric">@s.Alias</a>
                            <span class="badge @(s.IsOnline ? "text-bg-success" : "text-bg-danger")">@(s.IsOnline ? "online" : "offline")</span>
                        </div>
                        <div class="mb-2">
                            @if (!string.IsNullOrEmpty(s.Model)) { <span class="badge text-bg-light border me-1">@s.Model</span> }
                            <span class="badge @UiFormat.ProtocolBadge(s.Protocol)">@s.Protocol</span>
                            @if (s.Role != PlugRole.Plug)
                            {
                                <span class="badge text-bg-info" title="@PlugRoles.Description(s.Role)"><i class="bi @PlugRoles.Icon(s.Role) me-1"></i>@PlugRoles.Name(s.Role)</span>
                            }
                        </div>
                        @if (s.LastReading is not null)
                        {
                            <div class="fs-4 fw-semibold">
                                @((s.LastReading.PowerMw / 1000.0).ToString("0.0")) W
                                @if (s.Protocol == PlugProtocols.ShellyRpc && s.LastReading.PowerMw < ReversedBelowMw)
                                {
                                    <span class="badge text-bg-warning fs-6 align-middle" title="Putere negativă: clema e montată invers (sau energia e livrată în rețea). Se poate corecta din aplicația Shelly (reverse); KasaMonitor nu schimbă configurația.">inversat?</span>
                                }
                            </div>
                            <div class="small text-secondary">
                                @if (s.LastReading.VoltageMv is { } mv)
                                {
                                    <span class="me-2">@((mv / 1000.0).ToString("0.0")) V</span>
                                }
                                @if (s.LastReading.CurrentMa is { } ma)
                                {
                                    <span class="me-2">@((ma / 1000.0).ToString("0.000")) A</span>
                                }
                                @if (s.LastReading.PowerFactor is { } pf)
                                {
                                    <span class="me-2" title="Factor de putere">pf @pf.ToString("0.00")</span>
                                }
                                @if (s.Protocol is PlugProtocols.Legacy or PlugProtocols.ShellyRpc && s.LastReading.TotalWh is { } totalWh)
                                {
                                    <span title="Contorul cumulativ al prizei">Total @((totalWh / 1000.0).ToString("0.000")) kWh</span>
                                }
                            </div>
                            @if (s.LastReading.TodayWh is { } todayWh)
                            {
                                <div class="small text-secondary">@EnergyFormat.Line("Azi", todayWh, _tariff)</div>
                            }
                            @if (s.LastReading.MonthWh is { } monthWh)
                            {
                                <div class="small text-secondary">@EnergyFormat.Line("Luna", monthWh, _tariff)</div>
                            }
                        }
                    </div>
                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center small">
                        <span class="text-secondary" title="@UiFormat.FullLocal(s.LastSampleUtc)"><i class="bi bi-clock me-1"></i>@((_now - s.LastSampleUtc).TotalSeconds.ToString("0")) s ago</span>
                        @* R6 (0.10.0): the settings read from the device moved to its row on /dispozitive. *@
                        <a class="btn btn-sm btn-outline-secondary" href="@DevicePages.Row(DeviceRow.PlugKey(s.PlugId))" title="Configurare și setările citite din priză (Dispozitive)">
                            <i class="bi bi-gear me-1"></i>Detalii
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private Dictionary<Guid, PlugLiveState> _states = new();
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    /// <summary>"Restul casei" of the last whole minute (shared, computed once per minute by HouseRestService).</summary>
    private KasaMonitor.Core.Metering.RestBalance? _rest;

    private async Task LoadRestAsync()
    {
        try { _rest = await HouseRest.GetAsync(CancellationToken.None); }
        catch (Exception) { _rest = null; }
    }
    private System.Threading.Timer? _refreshTimer;

    /// <summary>"inversat?" is shown below -10 W (small negative readings of an idle channel are noise).</summary>
    private const long ReversedBelowMw = -10_000;

    private const string DayCountersNote =
        "Suma contoarelor de azi / din lună raportate de prize (Kasa, Tapo). Prizele Shelly nu au astfel de contoare în dispozitiv și nu sunt incluse aici (istoricul lor zilnic e în Istoric); contoarele (rol contor general / sub-contor) nu intră în totaluri.";

    /// <summary>A 1-second sample of the main meter older than this is ignored (the 10 s poll is shown instead).</summary>
    private static readonly TimeSpan LiveMaxAge = TimeSpan.FromSeconds(5);

    /// <summary>Plugs that count towards the header totals (role Plug): meters already include them.</summary>
    private IEnumerable<PlugLiveState> Counted => _states.Values.Where(s => PlugRoles.CountsInTotals(s.Role));

    private PlugLiveState? MainState => _states.Values.FirstOrDefault(s => s.Role == PlugRole.MainMeter);

    private double TotalPowerW => KasaMonitor.Core.Metering.HouseBalance.PlugsW(_states.Values);

    private KasaMonitor.Core.Costing.TariffCalculator _tariff = null!;
    private int _ticks;

    private decimal HourlyCostRon => _tariff.CostFromWh((long)TotalPowerW);

    private long? TodayTotalWh => EnergyFormat.Sum(Counted.Select(s => s.LastReading), r => r.TodayWh);
    private long? MonthTotalWh => EnergyFormat.Sum(Counted.Select(s => s.LastReading), r => r.MonthWh);

    /// <summary>Tariff saved in /settings (falls back to the startup value); re-read every 30 s.</summary>
    private async Task LoadTariffAsync()
    {
        try { _tariff = new KasaMonitor.Core.Costing.TariffCalculator((await KasaSettings.GetAsync(CancellationToken.None)).TariffRonPerKwh); }
        catch (Exception) { _tariff ??= DefaultTariff; }
    }

    protected override async Task OnInitializedAsync()
    {
        _tariff = DefaultTariff;
        await LoadTariffAsync();
        await LoadRestAsync();
        _states = Broadcaster.Snapshot().ToDictionary(kv => kv.Key, kv => kv.Value);
        Broadcaster.StateChanged += OnStateChanged;
        Broadcaster.StateRemoved += OnStateRemoved;
        _refreshTimer = new System.Threading.Timer(_ =>
            InvokeAsync(async () =>
            {
                _now = DateTimeOffset.UtcNow;
                if (++_ticks % 30 == 0) await LoadTariffAsync();
                await LoadRestAsync();
                StateHasChanged();
            }),
            null, 1000, 1000);
    }

    private void OnStateChanged(PlugLiveState state)
    {
        InvokeAsync(() =>
        {
            _states[state.PlugId] = state;
            _now = DateTimeOffset.UtcNow;
            StateHasChanged();
        });
    }

    private void OnStateRemoved(Guid plugId)
    {
        InvokeAsync(() =>
        {
            _states.Remove(plugId);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Broadcaster.StateChanged -= OnStateChanged;
        Broadcaster.StateRemoved -= OnStateRemoved;
        _refreshTimer?.Dispose();
    }
}
