          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum_over_time(clamp_min(max by (alias) (kasa_power_total) - max by (alias) (kasa_power_total offset 5m), 0)[30d:5m]) / 1000 * $tariff",
          "instant": true,
