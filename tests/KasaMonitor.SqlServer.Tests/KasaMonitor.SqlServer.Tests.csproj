<Project Sdk="Microsoft.NET.Sdk">
  <!-- The data layer on a real SQL Server (Testcontainers, image mcr.microsoft.com/mssql/server:2022-latest): the InitialCreate
       migration, the collation, the repository tests of KasaMonitor.Data.Tests (linked, same code, SQL Server instead of SQLite),
       the app start-up and the SQLite → SQL Server data migration tool. Skipped when Docker is not available. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>KasaMonitor.SqlServer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <PackageReference Include="FluentAssertions" Version="6.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.*" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KasaMonitor.Data\KasaMonitor.Data.csproj" />
    <ProjectReference Include="..\..\src\KasaMonitor.Web\KasaMonitor.Web.csproj" />
    <ProjectReference Include="..\..\tools\KasaMonitor.DataMigration\KasaMonitor.DataMigration.csproj" />
  </ItemGroup>

  <!-- The repository tests of KasaMonitor.Data.Tests, compiled here against a SQL Server TestDbFactory. Left out: the
       SQLite-only ones (schema through sqlite_master, SqliteException). -->
  <ItemGroup>
    <Compile Include="..\KasaMonitor.Data.Tests\*RepositoryTests.cs" Link="DataTests\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\deploy\sql\create-database.sql" Link="sql\create-database.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
