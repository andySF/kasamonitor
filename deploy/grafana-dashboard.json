{
  "dashboard": {
    "uid": "kasamonitor-v2",
    "title": "KasaMonitor",
    "tags": ["kasa", "energy"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "10s",
    "time": { "from": "now-6h", "to": "now" },
    "templating": {
      "list": [
        {
          "name": "tariff",
          "type": "constant",
          "label": "RON/kWh",
          "current": { "value": "1.30", "text": "1.30" },
          "query": "1.30",
          "hide": 0
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Total Power",
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "Txb48lDnk" },
        "targets": [{ "expr": "sum(kasa_power_load)", "refId": "A" }],
        "fieldConfig": {
          "defaults": {
            "unit": "watt",
            "decimals": 0,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 500 },
                { "color": "red", "value": 1000 }
              ]
            }
          }
        },
        "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Plugs Online",
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "Txb48lDnk" },
        "targets": [
          { "expr": "count(kasa_online == 1)", "refId": "A", "legendFormat": "online" },
          { "expr": "count(kasa_online)", "refId": "B", "legendFormat": "total" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            }
          }
        },
        "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Energy 24h",
        "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "Txb48lDnk" },
        "targets": [{ "expr": "sum(increase(kasa_power_total[24h])) / 1000", "refId": "A" }],
        "fieldConfig": {
          "defaults": {
            "unit": "kwatth",
            "decimals": 2,
            "color": { "mode": "fixed", "fixedColor": "blue" }
          }
        },
        "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto" }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Cost 24h",
        "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "Txb48lDnk" },
        "targets": [{ "expr": "sum(increase(kasa_power_total[24h])) / 1000 * $tariff", "refId": "A" }],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyEUR",
            "decimals": 2,
            "color": { "mode": "fixed", "fixedColor": "orange" }
          },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "RON" }, { "id": "unit", "value": "none" }] }
          ]
        },
        "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto" }
      },
      {
        "id": 10,
        "type": "timeseries",
        "title": "Power per plug (W)",
        "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "Txb48lDnk" },
        "targets": [
          { "expr": "kasa_power_load", "refId": "A", "legendFormat": "{{alias}}" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "watt",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 15,
              "showPoints": "never"
            }
          }
        },
        "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "Voltage (V)",
        "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "Txb48lDnk" },
        "targets": [
          { "expr": "kasa_voltage", "refId": "A", "legendFormat": "{{alias}}" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "volt",
            "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 0, "showPoints": "never" }
          }
        },
        "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean"] }, "tooltip": { "mode": "multi" } }
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "Current (A)",
        "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "Txb48lDnk" },
        "targets": [
          { "expr": "kasa_current", "refId": "A", "legendFormat": "{{alias}}" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "amp",
            "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 0, "showPoints": "never" }
          }
        },
        "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
      },
      {
        "id": 20,
        "type": "table",
        "title": "Energy & cost per plug",
        "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "Txb48lDnk" },
        "targets": [
          { "expr": "increase(kasa_power_total[24h]) / 1000", "refId": "A", "legendFormat": "{{alias}}", "format": "table", "instant": true },
          { "expr": "increase(kasa_power_total[7d]) / 1000", "refId": "B", "legendFormat": "{{alias}}", "format": "table", "instant": true },
          { "expr": "increase(kasa_power_total[30d]) / 1000", "refId": "C", "legendFormat": "{{alias}}", "format": "table", "instant": true },
          { "expr": "kasa_power_load", "refId": "D", "legendFormat": "{{alias}}", "format": "table", "instant": true }
        ],
        "fieldConfig": {
          "defaults": { "decimals": 2 },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Value #A" }, "properties": [{ "id": "displayName", "value": "kWh 24h" }, { "id": "unit", "value": "kwatth" }] },
            { "matcher": { "id": "byName", "options": "Value #B" }, "properties": [{ "id": "displayName", "value": "kWh 7d" }, { "id": "unit", "value": "kwatth" }] },
            { "matcher": { "id": "byName", "options": "Value #C" }, "properties": [{ "id": "displayName", "value": "kWh 30d" }, { "id": "unit", "value": "kwatth" }] },
            { "matcher": { "id": "byName", "options": "Value #D" }, "properties": [{ "id": "displayName", "value": "Now (W)" }, { "id": "unit", "value": "watt" }] },
            { "matcher": { "id": "byName", "options": "alias" }, "properties": [{ "id": "displayName", "value": "Plug" }] },
            { "matcher": { "id": "byRegexp", "options": "(Time|mac|instance|job|__name__)" }, "properties": [{ "id": "custom.hidden", "value": true }] }
          ]
        },
        "options": { "showHeader": true, "cellHeight": "sm" },
        "transformations": [
          { "id": "merge", "options": {} }
        ]
      },
      {
        "id": 30,
        "type": "state-timeline",
        "title": "Online status",
        "gridPos": { "x": 0, "y": 28, "w": 24, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "Txb48lDnk" },
        "targets": [
          { "expr": "kasa_online", "refId": "A", "legendFormat": "{{alias}}" }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "0": { "text": "OFFLINE", "color": "red" }, "1": { "text": "ONLINE", "color": "green" } } }
            ],
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
          }
        },
        "options": { "mergeValues": true, "showValue": "never", "alignValue": "left", "rowHeight": 0.9 }
      }
    ]
  },
  "overwrite": true,
  "message": "Created by KasaMonitor (Claude)"
}
