@using System.Globalization
@using KasaMonitor.Workers
@using KasaMonitor.Core.Climate
@inject IClimateSettingsService ClimateSettings
@inject ClimateState Climate
@inject ClimateWorker Worker

@* /settings „Climă: temperatura exterioară”: latitude/longitude for Open-Meteo (empty = off). *@
<div class="card h-100">
    <div class="card-header fw-semibold"><i class="bi bi-cloud-sun me-2"></i>Climă: temperatura exterioară (Open-Meteo)</div>
    <div class="card-body">
        @if (_s is null)
        {
            <span class="text-secondary small">Se încarcă…</span>
        }
        else
        {
            <div class="row g-2 mb-2">
                <div class="col-sm-6">
                    <label class="form-label" for="cLat">Latitudine</label>
                    <input class="form-control" id="cLat" @bind="_lat" placeholder="ex. 44.4268" inputmode="decimal" autocomplete="off" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="cLon">Longitudine</label>
                    <input class="form-control" id="cLon" @bind="_lon" placeholder="ex. 26.1025" inputmode="decimal" autocomplete="off" />
                </div>
            </div>
            <div class="small mb-2">
                @if (_s.HasLocation)
                {
                    <span class="badge text-bg-success">activ</span>
                    <span class="ms-1 text-secondary">senzorul „Afară” se citește la 15 min · cereri azi: @Climate.OpenMeteoCalls.Today</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">oprit</span>
                    <span class="ms-1 text-secondary">fără coordonate nu se face nicio cerere</span>
                }
                @if (Climate.SourceStatus(ClimateSources.OpenMeteo) is { } st) { <div class="text-danger">@st</div> }
            </div>
            <div class="form-text">
                Open-Meteo e gratuit și fără cheie (<code>api.open-meteo.com</code>); se trimit doar coordonatele. Lasă ambele câmpuri goale ca să-l oprești.
                Senzorul „Afară” apare în <a href="/clima">Climă</a> și ca rândul „Afară” în <a href="/centrala">Centrală</a>.
            </div>
            <div class="d-flex align-items-center gap-2 mt-2">
                <button class="btn btn-primary btn-sm" @onclick="SaveAsync"><i class="bi bi-save me-1"></i>Salvează locația</button>
                @if (_saved) { <span class="text-success small"><i class="bi bi-check-circle me-1"></i>Salvat.</span> }
                @if (_error is not null) { <span class="text-danger small">@_error</span> }
            </div>
            <hr />
            <div class="row g-2 align-items-end">
                <div class="col-sm-6">
                    <label class="form-label" for="cHdd">Baza gradelor-zile de încălzire (°C)</label>
                    <input class="form-control" id="cHdd" @bind="_hddBase" inputmode="decimal" autocomplete="off" />
                </div>
                <div class="col-sm-6">
                    <button class="btn btn-outline-primary btn-sm" @onclick="SaveHddAsync"><i class="bi bi-save me-1"></i>Salvează baza</button>
                    @if (_hddSaved) { <span class="text-success small ms-1"><i class="bi bi-check-circle me-1"></i>Salvat.</span> }
                </div>
            </div>
            <div class="form-text">
                Pentru <a href="/history#clima">Istoric → Climă</a>: grade-zile = bază − temperatura medie de afară, în zilele cu media ≤ bază − 3 °C
                (metoda Eurostat: bază 18 °C, prag 15 °C; implicit). SR 4839 folosește altă metodă (bază 20 °C, prag 12 °C). Între @ClimateSettingsService.MinDegreeDaysBaseC.ToString("0", CultureInfo.InvariantCulture) și @ClimateSettingsService.MaxDegreeDaysBaseC.ToString("0", CultureInfo.InvariantCulture) °C.
            </div>
            @if (_hddError is not null) { <div class="text-danger small">@_hddError</div> }
        }
    </div>
</div>

@code {
    private ClimateRuntimeSettings? _s;
    private string _lat = "";
    private string _lon = "";
    private bool _saved;
    private string? _error;
    private string _hddBase = "";
    private bool _hddSaved;
    private string? _hddError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _s = await ClimateSettings.GetAsync(CancellationToken.None);
        _lat = _s.Latitude?.ToString("0.#####", CultureInfo.InvariantCulture) ?? "";
        _lon = _s.Longitude?.ToString("0.#####", CultureInfo.InvariantCulture) ?? "";
        _hddBase = _s.HeatingDegreeDaysBaseC.ToString("0.#", CultureInfo.InvariantCulture);
    }

    private async Task SaveHddAsync()
    {
        _hddError = null;
        try
        {
            if (ClimateSettingsService.ParseCoordinate(_hddBase) is not { } b)
                throw new ArgumentException("Baza trebuie să fie un număr (ex. 18).");
            await ClimateSettings.SaveHeatingDegreeDaysBaseAsync(b, CancellationToken.None);
            await LoadAsync();
            _hddSaved = true;
            StateHasChanged();
            await Task.Delay(2000);
            _hddSaved = false;
        }
        catch (ArgumentException ex)
        {
            _hddError = ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        try
        {
            var lat = ClimateSettingsService.ParseCoordinate(_lat);
            var lon = ClimateSettingsService.ParseCoordinate(_lon);
            if (lat is null && !string.IsNullOrWhiteSpace(_lat) || lon is null && !string.IsNullOrWhiteSpace(_lon))
                throw new ArgumentException("Coordonatele trebuie să fie numere (ex. 44.4268).");
            await ClimateSettings.SaveLocationAsync(lat, lon, CancellationToken.None);
            Worker.Wake();
            await LoadAsync();
            _saved = true;
            StateHasChanged();
            await Task.Delay(2000);
            _saved = false;
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
    }
}
