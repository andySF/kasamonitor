@page "/history"
@rendermode InteractiveServer
@using KasaMonitor.Core.Costing
@using KasaMonitor.Core.Home
@using KasaMonitor.Core.Reports
@using KasaMonitor.Workers
@using KasaMonitor.Web.Ui
@inject HomeService Home
@inject HistoryService HistorySvc
@inject EnergyReportService Reports
@inject IKasaSettingsService KasaSettings
@inject IHeatingSettingsService HeatingSettings
@inject TariffCalculator DefaultTariff
@inject NavigationManager Nav
@inject ILogger<History> Log

<PageTitle>KasaMonitor — Istoric</PageTitle>

@* /history (0.9.2): one long page for the past of everything monitored, one period for all of it (Zi / Săptămână / Lună /
   An / Interval, ◀ ▶, kept in the address: ?p=luna&d=2026-11&cmp=1&plug=…), a summary row with anchors, then the sections
   Curent · Gaz și centrală · Aparate · Consumatori · Climă · Costuri · Evenimente; each loads on its own (cached
   aggregates: HomeService for electricity, HistoryService for the rest), each has a chart, key figures, a table and its
   CSV; a click on a bar opens that day (that month). *@
<div class="home hist">
    <div class="topbar hist-top">
        <h1>Istoric</h1>
        <ReportPeriodPicker Period="_period" PeriodChanged="OnPeriodChangedAsync" Today="_today" AllowRange="true" />
        <label class="switch" title="Δ față de perioada precedentă (o perioadă în curs: față de aceeași parte din ea, ca în Acasă) și barele ei palide">
            <input type="checkbox" role="switch" aria-checked="@(_compare ? "true" : "false")" checked="@_compare" @onchange="OnCompareChanged" />
            <span>@(IsToday ? "Compară cu ieri (la aceeași oră)" : PeriodNames.For(_period.Kind).Compare)</span>
        </label>
        <nav class="hist-chips" aria-label="Secțiuni">
            <a href="#curent">Curent</a><a href="#gaz">Gaz</a><a href="#aparate">Aparate</a><a href="#consumatori">Consumatori</a><a href="#clima">Climă</a><a href="#costuri">Costuri</a><a href="#evenimente">Evenimente</a>
        </nav>
    </div>
    @if (_errors.Count > 0)
    {
        <div class="alert alert-warning py-2">Unele secțiuni nu au putut fi calculate acum (@string.Join(", ", _errors)); detaliul e în jurnalul aplicației.</div>
    }

    @{
        var c = HomeComparison.Build(_home, IsToday, _prices);
        var names = PeriodNames.For(_period.Kind);
        var gas = _gas;
        var m3 = gas?.Report.Gas.Total;
        var gasPrev = gas is null ? null : gas.Report.Gas.InProgress ? gas.Report.Gas.PreviousSameFraction : gas.Report.Gas.PreviousTotal;
        var costNow = _prices.Total(c.CurrentKwh, m3);
        var costPrev = _prices.Total(c.PreviousKwh, gasPrev);
        var cost = c with { CurrentCostRon = costNow, PreviousCostRon = costPrev };
        var miele = _miele;
        var climate = _climate;
        var rooms = climate?.Sensors.Where(s => !s.Sensor.IsOutdoor && s.Period.AvgC is not null).ToList();
        var outdoor = climate?.Sensors.FirstOrDefault(s => s.Sensor.IsOutdoor);
    }
    <div class="hist-summary" aria-label="Rezumatul perioadei">
        <a class="tile plain" href="#curent">
            <div class="lbl"><i class="sw bar k-plug"></i>Curent</div>
            <div class="val num">@HomeFormat.Kwh(c.Kwh) <small>kWh</small></div>
            <div class="meta">@HomeFormat.Lei(c.ElectricityRon)</div>
            @if (_compare && _home is not null) { <HistoryDelta Delta="@(HomeFormat.Delta(c.CurrentKwh, c.PreviousKwh, v => HomeFormat.Kwh(v), "kWh"))" Partial="c.Partial" Versus="@c.Versus" PreviousName="@c.PreviousName" /> }
        </a>
        <a class="tile plain" href="#gaz">
            <div class="lbl"><i class="sw bar k-gas"></i>Gaz</div>
            <div class="val num">@HomeFormat.M3(m3) <small>m³</small></div>
            <div class="meta">@HomeFormat.Lei(_prices.Gas(m3))</div>
            @if (_compare && m3 is not null)
            {
                <HistoryDelta Delta="@(HomeFormat.Delta(m3, gasPrev, v => HomeFormat.M3(v), "m³"))" PreviousName="@names.Previous"
                              Versus="@(gas!.Report.Gas.InProgress ? "față de aceeași parte din " + names.Previous : names.Versus)" />
            }
        </a>
        <a class="tile plain" href="#costuri">
            <div class="lbl">Cost total</div>
            <div class="val num">@HomeFormat.Lei(_prices.Total(c.Kwh, m3))</div>
            <div class="meta">curent + gaz, la tarifele actuale</div>
            @if (_compare && _home is not null) { <HistoryDelta Delta="@(HomeFormat.DeltaLei(costNow, costPrev))" Partial="c.Partial" Versus="@c.Versus" PreviousName="@c.PreviousName" /> }
        </a>
        <a class="tile plain" href="#gaz">
            <div class="lbl">Ore de ardere</div>
            <div class="val num">@(gas?.BurnerHours is { } bh ? HeatingFormat.Number(bh, 1) : "—") <small>h</small></div>
            <div class="meta">@(gas?.BurnerStarts is { } bs ? $"{bs} porniri" : "—")</div>
        </a>
        <a class="tile plain" href="#aparate">
            <div class="lbl">Cicluri Miele</div>
            <div class="val num">@(miele is null ? "—" : miele.Cycles.Count.ToString())</div>
            <div class="meta">@(miele is null ? "" : HomeFormat.KwhU(KasaMonitor.Core.Reports.ReportMath.SumOrNull(miele.Cycles.Select(x => x.BestKwh))))</div>
        </a>
        <a class="tile plain" href="#clima">
            <div class="lbl">Temperatura medie</div>
            <div class="val num">@HeatingFormat.Number(rooms is { Count: > 0 } r ? r.Average(s => s.Period.AvgC!.Value) : null, 1) <small>°C casă</small></div>
            <div class="meta">afară @HeatingFormat.Temp(outdoor?.Period.AvgC)</div>
        </a>
    </div>

    <HistoryCurrentSection Data="_home" Prices="_prices" Comparison="c" Compare="_compare" Plug="_plug" PlugChanged="OnPlugChangedAsync" Now="_now"
                           CsvHref="@Csv(HistorySections.Electricity, _plug)" />
    <HistoryGasSection Data="_gas" Loaded="_gasLoaded" Prices="_prices" Compare="_compare" Now="_now" BoilerTz="Reports.BoilerTimeZone" LocalTz="Reports.TimeZone"
                       CsvHref="@Csv(HistorySections.Gas)" />
    <HistoryMieleSection Data="_miele" Prices="_prices" Tz="Reports.TimeZone" CsvHref="@Csv(HistorySections.MieleCycles)" ProgramsCsvHref="@Csv(HistorySections.MielePrograms)" />
    <HistoryDetectedSection Data="_detected" Period="_period" Compare="_compare" Prices="_prices" CsvHref="@Csv(HistorySections.Consumers)" DetectedCsvHref="@Csv(HistorySections.Detected)" />
    <HistoryClimateSection Data="_climate" Period="_period" Compare="_compare" Now="_now" CsvHref="@Csv(HistorySections.Climate)" DegreeDaysCsvHref="@Csv(HistorySections.DegreeDays)" />
    <HistoryCostSection Electricity="_home" Gas="_gas" Bill="_bill" Prices="_prices" Comparison="cost" Period="_period" Today="_today" Compare="_compare" Now="_now"
                        Tz="Reports.TimeZone" CsvHref="@Csv(HistorySections.Costs)" />
    <HistoryEventsSection Data="_events" Tz="Reports.TimeZone" CsvHref="@Csv(HistorySections.Events)" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "p")] public string? QueryKind { get; set; }
    [SupplyParameterFromQuery(Name = "d")] public string? QueryDay { get; set; }
    [SupplyParameterFromQuery(Name = "de")] public string? QueryFrom { get; set; }
    [SupplyParameterFromQuery(Name = "pana")] public string? QueryTo { get; set; }
    [SupplyParameterFromQuery(Name = "cmp")] public string? QueryCompare { get; set; }
    // Strings, parsed with TryParse: a malformed id (?plug=abc) is ignored instead of failing the page.
    [SupplyParameterFromQuery(Name = "plug")] public string? QueryPlug { get; set; }
    /// <summary>The address of 0.9.0 and before (/history?plugId=…): the same plug filter.</summary>
    [SupplyParameterFromQuery(Name = "plugId")] public string? QueryPlugId { get; set; }

    private ReportPeriod _period;
    private DateOnly _today;
    private DateTimeOffset _now;
    private bool _compare = true;
    private Guid? _plug;
    private bool _initialized;
    private int _version;
    private EnergyPrices _prices = new(1.30m, KasaMonitor.Core.Heating.ViessmannApi.DefaultKwhPerM3, 0, false);

    private HomePeriod? _home;
    private HistoryGas? _gas;
    private bool _gasLoaded;
    private HistoryMiele? _miele;
    private HistoryDetected? _detected;
    private HistoryClimate? _climate;
    private HistoryEventList? _events;
    private BillEstimate? _bill;
    private readonly SortedSet<string> _errors = new();

    private bool IsToday => _period.Kind == ReportGranularity.Day && _period.Start == _today;

    protected override async Task OnInitializedAsync()
    {
        _today = HistorySvc.Today();
        _prices = _prices with { TariffRonPerKwh = DefaultTariff.RonPerKwh };
        ReadQuery();
        _initialized = true;
        await LoadAsync();
    }

    /// <summary>The address changed (◀ ▶, a link, back/forward): follow it; a new period reloads, the rest only redraws.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized) return;
        var before = _period;
        ReadQuery();
        if (_period != before) await LoadAsync();
    }

    private void ReadQuery()
    {
        _period = PeriodQuery.Parse(QueryKind, QueryDay, QueryFrom, QueryTo, _today, ReportGranularity.Month);
        _compare = PeriodQuery.Compare(QueryCompare);
        _plug = PeriodQuery.Plug(QueryPlug) ?? PeriodQuery.Plug(QueryPlugId);
    }

    private string Csv(string section, Guid? plug = null) =>
        "/history/export.csv?section=" + section + "&" + PeriodQuery.Format(_period) + (_compare ? "" : "&cmp=0") + (plug is { } id ? "&plug=" + id : "");

    /// <summary>
    /// Starts every section at once; each one shows as soon as it is there (interactive), the prerender waits for all of them.
    /// A section that fails shows its name in the warning; the others are not held back.
    /// </summary>
    private async Task LoadAsync()
    {
        var version = ++_version;
        _today = HistorySvc.Today();
        _now = DateTimeOffset.UtcNow;
        var period = _period;
        (_home, _gas, _gasLoaded, _miele, _detected, _climate, _events) = (null, null, false, null, null, null, null);
        _errors.Clear();
        var ct = CancellationToken.None;
        var tasks = new List<Task>
        {
            Section("prețuri", () => Task.Run(() => HistoryPrices.LoadAsync(KasaSettings, HeatingSettings, false, ct)), p => _prices = p with { HasGas = _gas is not null || _prices.HasGas }, version),
            Section("curent", () => Home.GetAsync(period, ct), d => _home = d, version),
            Section("gaz", () => HistorySvc.GetGasAsync(period, ct), g => { _gas = g; _gasLoaded = true; _prices = _prices with { HasGas = g is not null }; }, version),
            Section("aparate", () => HistorySvc.GetMieleAsync(period, ct), m => _miele = m, version),
            Section("consumatori", () => HistorySvc.GetDetectedAsync(period, ct), d => _detected = d, version),
            Section("climă", () => HistorySvc.GetClimateAsync(period, ct), x => _climate = x, version),
            Section("evenimente", () => HistorySvc.GetEventsAsync(period, ct), e => _events = e, version),
            Section("estimare", () => Home.Metrics.Bill is { } b ? Task.FromResult<BillEstimate?>(b) : Home.GetBillAsync(ct), b => _bill = b, version),
        };
        if (!RendererInfo.IsInteractive) await Task.WhenAll(tasks);
    }

    private async Task Section<T>(string name, Func<Task<T>> load, Action<T> set, int version)
    {
        try
        {
            var value = await load();
            if (version != _version) return;
            set(value);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "History section {Section} of {Kind} {Start} could not be computed", name, _period.Kind, _period.Start);
            if (version != _version) return;
            _errors.Add(name);
            if (name == "gaz") _gasLoaded = true;
        }
        if (RendererInfo.IsInteractive) await InvokeAsync(StateHasChanged);
    }

    private Task OnPeriodChangedAsync(ReportPeriod p)
    {
        Nav.NavigateTo(PeriodQuery.History(p, _compare, _plug));
        return Task.CompletedTask;
    }

    private void OnCompareChanged(ChangeEventArgs e)
    {
        var on = e.Value is true || e.Value is string s && bool.TryParse(s, out var b) && b;
        Nav.NavigateTo(PeriodQuery.History(_period, on, _plug), new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private Task OnPlugChangedAsync(Guid? plug)
    {
        Nav.NavigateTo(PeriodQuery.History(_period, _compare, plug, "curent"), new NavigationOptions { ReplaceHistoryEntry = true });
        return Task.CompletedTask;
    }
}
