@using KasaMonitor.Web.Ui
@inject ILiveStreamBroadcaster Stream
@implements IDisposable

@* Live power of the main meter and of any overlaid plugs, last 10 minutes. Rendered once. Samples only update the latest
   value of their series; once a second LiveChartGrid adds one point with the same x to every series, and those points
   are appended to the chart together: ApexCharts pairs appended data with its series by position, so the dictionary
   always names all of them. Every LiveChartGrid.TrimEvery ticks the whole window is pushed once (UpdateSeriesAsync) so
   the chart drops the points older than 10 minutes. *@
<ApexChart @ref="_chart" TItem="LivePoint" Options="_options" Height="260" XAxisType="XAxisType.Datetime" OnRendered="OnChartRendered">
    @foreach (var s in _series)
    {
        <ApexPointSeries @key="s.Id"
                         TItem="LivePoint"
                         Items="_grid.Points(s.Id)"
                         Name="@s.Name"
                         Color="@s.Color"
                         SeriesType="SeriesType.Line"
                         XValue="@(p => p.TimeUtc)"
                         YValue="@(p => p.PowerW)" />
    }
</ApexChart>

@code {
    [Parameter, EditorRequired] public Guid PlugId { get; set; }
    [Parameter] public string MainName { get; set; } = "Casă (W)";

    /// <summary>The plugs drawn over the main meter (same live stream).</summary>
    [Parameter] public IReadOnlyList<LiveChartSeries> Overlays { get; set; } = Array.Empty<LiveChartSeries>();

    private List<LiveChartSeries> _series = new();
    private LiveChartGrid _grid = null!;
    private ApexChart<LivePoint>? _chart;
    private bool _rendered;
    private bool _chartReady;
    private bool _sending;
    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(1));

    private readonly ApexChartOptions<LivePoint> _options = new()
    {
        Chart = new Chart
        {
            Toolbar = new Toolbar { Show = false },
            Animations = new Animations { Enabled = false },
            Zoom = new Zoom { Enabled = false },
        },
        Stroke = new Stroke { Width = 2, Curve = Curve.Straight },
        Markers = new Markers { Size = 0 },
        DataLabels = new DataLabels { Enabled = false },
        Xaxis = new XAxis { Labels = new XAxisLabels { DatetimeUTC = false } },
        Yaxis = new List<YAxis> { new() { DecimalsInFloat = 0, Title = new AxisTitle { Text = "W" } } },
        Tooltip = new Tooltip { Shared = true, X = new TooltipX { Format = "HH:mm:ss" } },
    };

    protected override void OnInitialized()
    {
        var lines = Overlays.Prepend(new LiveChartSeries(PlugId, MainName, LiveChartColors.Main)).ToList();
        var names = LiveChartGrid.UniqueNames(lines.Select(l => l.Name));
        _series = lines.Select((l, i) => l with { Name = names[i] }).ToList();
        _grid = new LiveChartGrid(_series.Select(s => s.Id));
        _grid.Seed(Stream.Recent, DateTimeOffset.UtcNow);
        _options.Legend = new Legend { Show = Overlays.Count > 0 };
        Stream.SampleReceived += OnSample;
    }

    protected override bool ShouldRender() => !_rendered;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _rendered = true;
        _ = RunTicksAsync();
    }

    private void OnSample(LiveSample s) => _grid.Observe(s);

    private async Task RunTicksAsync()
    {
        try
        {
            // The send is not awaited: a slow one must not swallow ticks, their points wait in the windows.
            while (await _timer.WaitForNextTickAsync())
                await InvokeAsync(() => { if (_grid.Tick(DateTimeOffset.UtcNow)) _ = SendAsync(); });
        }
        catch (ObjectDisposedException) { /* circuit gone */ }
    }

    /// <summary>The first render took the points added until then.</summary>
    private void OnChartRendered()
    {
        _grid.MarkSent(LastPointInChart());
        _chartReady = true;
    }

    private async Task SendAsync()
    {
        // One send at a time; the points of a tick that arrives meanwhile are in the windows and go with the next send.
        if (!_chartReady || _sending || _chart is null) return;
        _sending = true;
        try
        {
            var fullPush = _grid.FullPushDue;
            if (fullPush)
            {
                await _chart.UpdateSeriesAsync(false);
            }
            else
            {
                var pending = _grid.Pending();
                if (pending.Values.All(p => p.Count == 0)) return;
                await _chart.AppendDataBySeriesNameAsync(_series.ToDictionary(s => s.Name, s => (IEnumerable<LivePoint>)pending[s.Id]));
            }
            _grid.MarkSent(LastPointInChart(), fullPush);
        }
        catch (Exception) { /* circuit gone or chart not ready yet; what was not marked goes with the next send */ }
        finally { _sending = false; }
    }

    /// <summary>
    /// The newest x the chart was given. Read from the chart's own series, not from the windows: UpdateSeriesAsync reads
    /// the windows only after a yield, so a tick that slips in before that is already in the chart.
    /// </summary>
    private DateTime? LastPointInChart() => _options.Series?.FirstOrDefault()?.Data?.LastOrDefault()?.X as DateTime?;

    public void Dispose()
    {
        Stream.SampleReceived -= OnSample;
        _timer.Dispose();   // ends the loop of RunTicksAsync
    }
}
